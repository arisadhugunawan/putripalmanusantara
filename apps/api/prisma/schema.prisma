model AboutCompanySectionConfig {
  id        String   @id @default(cuid())
  key       String   @unique // "company" | "team" | "what_we_do" | "legal_certificate" | "factory"
  order     Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("about_company_section_config")
}

model AboutCompanyPublishedSnapshot {
  id          String   @id @default(cuid())
  data        Json
  publishedAt DateTime @default(now()) @map("published_at")

  @@index([publishedAt])
  @@map("about_company_published_snapshot")
}

// Section 01 "CV. Putri Palma Nusantara" (singleton, get-or-create — same idiom as
// HomepageAboutPreview).
model AboutCompanyProfile {
  id               String   @id @default(cuid())
  headline         String   @default("CV. Putri Palma Nusantara")
  shortDescription String   @default("") @map("short_description")
  mainDescription  String   @default("") @map("main_description")
  vision           String   @default("")
  mission          String   @default("")
  companyOverview  String   @default("") @map("company_overview")
  mainImageId      String?  @map("main_image_id")
  mainImage        Media?   @relation("AboutCompanyMainImage", fields: [mainImageId], references: [id])
  /// Any supported YouTube URL format (watch/youtu.be/embed) — the video ID is extracted on
  /// the frontend, so the Admin never has to construct an embed URL by hand.
  youtubeVideoUrl  String?  @map("youtube_video_url")
  /// "Connect With PPN" social row, shown directly under the video.
  socialLabel      String   @default("Connect With PPN") @map("social_label")
  socialVisible    Boolean  @default(true) @map("social_visible")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for every translatable text field on this singleton.
  translations     Json?

  // ── Storytelling blocks (Post-Launch company-profile redesign) ────────────
  // All blocks live on this one singleton rather than in separate tables: they are all the
  // same entity ("the company profile"), always read and published together, and a single
  // row keeps the Admin PUT atomic. Every block carries its own `*Visible` flag so an Admin
  // can turn a block off instead of being forced to invent content for it — nothing is
  // pre-filled with fabricated company claims.

  /// 01 Introduction.
  eyebrow    String  @default("Who We Are")
  subheading String  @default("")
  ctaLabel   String? @map("cta_label")
  ctaHref    String? @map("cta_href")

  /// 02 Company Story.
  storyLabel                String  @default("About PPN") @map("story_label")
  storyHeading              String  @default("") @map("story_heading")
  storyDescription          String  @default("") @map("story_description")
  storySecondaryDescription String  @default("") @map("story_secondary_description")
  storyImageId              String? @map("story_image_id")
  storyImage                Media?  @relation("AboutCompanyStoryImage", fields: [storyImageId], references: [id])
  storyVisible              Boolean @default(true) @map("story_visible")

  /// 03 Business Scope — renders the existing WhatWeDoItem records inside the profile story.
  /// Defaults to hidden so enabling it is a deliberate choice: "What We Do?" is also its own
  /// section on the About page, and showing both would repeat the same content twice.
  scopeLabel       String  @default("What We Do") @map("scope_label")
  scopeHeading     String  @default("") @map("scope_heading")
  scopeDescription String  @default("") @map("scope_description")
  scopeVisible     Boolean @default(false) @map("scope_visible")

  /// 05 Company Facts (rows live in AboutCompanyFact).
  factsLabel   String  @default("Company Facts") @map("facts_label")
  factsHeading String  @default("") @map("facts_heading")
  factsVisible Boolean @default(true) @map("facts_visible")

  /// 06/07 Global Export Reach — reuses the existing ExportDestination records and world map
  /// component; only this section's own copy lives here.
  exportLabel       String  @default("Global Export Reach") @map("export_label")
  exportHeading     String  @default("") @map("export_heading")
  exportDescription String  @default("") @map("export_description")
  exportVisible     Boolean @default(true) @map("export_visible")

  /// 08 Legal / company information. Blank fields are never rendered publicly.
  legalLabel        String  @default("Company Information") @map("legal_label")
  legalHeading      String  @default("") @map("legal_heading")
  businessType      String  @default("") @map("business_type")
  registeredAddress String  @default("") @map("registered_address")
  businessIdNumber  String  @default("") @map("business_id_number")
  establishedYear   String  @default("") @map("established_year")
  legalVisible      Boolean @default(true) @map("legal_visible")

  /// 09 Closing statement.
  closingLabel       String  @default("") @map("closing_label")
  closingHeading     String  @default("") @map("closing_heading")
  closingDescription String  @default("") @map("closing_description")
  closingCtaLabel    String? @map("closing_cta_label")
  closingCtaHref     String? @map("closing_cta_href")
  closingVisible     Boolean @default(true) @map("closing_visible")

  gallery AboutCompanyGalleryImage[]

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("about_company_profile")
}

/// One "Company Facts" row (item 17/18/40) — label/value pairs the Admin fully controls, so
/// the public grid only ever shows facts that actually exist. Deliberately generic rather
/// than fixed columns: the brief's own fact list is a suggestion, not a schema.
model AboutCompanyFact {
  id           String   @id @default(cuid())
  label        String
  value        String
  /// Optional icon key resolved by the public component's own allowlist — never a raw URL.
  icon         String?
  order        Int      @default(0)
  active       Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for label/value.
  translations Json?

  @@map("about_company_facts")
}

model AboutCompanyGalleryImage {
  id        String              @id @default(cuid())
  profileId String              @map("profile_id")
  profile   AboutCompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaId   String              @map("media_id")
  media     Media               @relation("AboutCompanyGalleryMedia", fields: [mediaId], references: [id])
  caption   String?
  altText   String?             @map("alt_text")
  order     Int                 @default(0)
  featured  Boolean             @default(false)
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at")

  @@map("about_company_gallery")
}

/// "Connect With PPN" social row under the company-profile video — free-choice platform per
/// row (unlike Contact Page's fixed four-slot social fields), since this section explicitly
/// asks for an open CRUD list including optional platforms (YouTube/WhatsApp/X/Other).
model AboutCompanySocialLink {
  id           String   @id @default(cuid())
  /// Free-text key used to pick an icon on the frontend (e.g. "instagram", "tiktok",
  /// "facebook", "linkedin", "youtube", "whatsapp", "twitter", "other") — not an enum, so a
  /// platform the Admin needs later doesn't require a schema change.
  platform     String
  displayName  String   @map("display_name")
  url          String
  active       Boolean  @default(true)
  openInNewTab Boolean  @default(true) @map("open_in_new_tab")
  order        Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("about_company_social_links")
}

// Section 02 "PPN Team".
model TeamMember {
  id               String   @id @default(cuid())
  name             String
  position         String
  biography        String   @default("")
  /// Free text or a newline-separated list; the public profile modal renders newline-separated
  /// lines as bullets. Kept as plain text because the Admin form here is a plain textarea.
  responsibilities String   @default("")
  /// Optional grouping ("Management", "Operations", …) so the same model can later drive
  /// several team lists without a schema change. Free text, not an enum: departments differ
  /// per company and an enum would need a migration for every new one.
  department       String?
  photoId          String?  @map("photo_id")
  photo            Media?   @relation("TeamMemberPhoto", fields: [photoId], references: [id])
  /// Renamed from `social_link` — it always held a profile URL, and the public card now
  /// labels it as LinkedIn. Renamed in place so existing values survive.
  linkedinUrl      String?  @map("linkedin_url")
  email            String?
  phone            String?
  order            Int      @default(0)
  active           Boolean  @default(true)
  featured         Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for name/position/biography/responsibilities/department.
  translations     Json?

  @@map("team_members")
}

/// Section 02's own heading copy (singleton, get-or-create). Separate from TeamMember so the
/// section keeps its title/description even when no members exist yet, and separate from
/// AboutCompanyProfile because it belongs to a different section of the page.
model AboutCompanyTeamSection {
  id           String   @id @default(cuid())
  eyebrow      String   @default("Meet the Team")
  heading      String   @default("The People Behind PPN")
  description  String   @default("")
  ctaLabel     String?  @map("cta_label")
  ctaHref      String?  @map("cta_href")
  /// Shows a live count of published team members. Off by default — a counter is only honest
  /// when it is derived, and only useful once there are enough members to be worth stating.
  showCounter  Boolean  @default(false) @map("show_counter")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for eyebrow/heading/description/ctaLabel.
  translations Json?

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("about_company_team_section")
}

// Section 03 "What We Do?" — mediaId is a single field the Admin uses for either a photo or
// an icon (SVG/PNG/WebP all pass the existing Media upload's `image/` MIME allowlist); the
// brief explicitly asks for "image OR icon", not both, so one optional relation is enough.
model WhatWeDoItem {
  id                  String   @id @default(cuid())
  title               String
  shortDescription    String   @default("") @map("short_description")
  detailedDescription String   @default("") @map("detailed_description")
  /// Short bullet points shown under the card description (e.g. "Export-oriented fresh
  /// coconut", "Flexible sourcing") — a plain string list, not rich text.
  keyPoints           String[] @default([]) @map("key_points")
  mediaId             String?  @map("media_id")
  media               Media?   @relation("WhatWeDoMedia", fields: [mediaId], references: [id])
  /// Optional link to a real catalogue product. A relation rather than a stored URL so the
  /// public link is always built from the product's current slug and can never go stale or
  /// point at a product that no longer exists.
  productId           String?  @map("product_id")
  product             Product? @relation("WhatWeDoProduct", fields: [productId], references: [id], onDelete: SetNull)
  order               Int      @default(0)
  active              Boolean  @default(true)
  featured            Boolean  @default(false)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title/shortDescription/detailedDescription.
  translations        Json?

  @@map("what_we_do_items")
}

/// Section-level copy for "What We Supply" (public heading is Admin-editable; the section key
/// in `AboutCompanySectionConfig` stays "what_we_do" — renaming it would be a breaking change to
/// the fixed 5-key section-navigator system, so only the public-facing text changes). Also
/// carries the "Who We Supply" sub-block's copy and the Buyer/Supplier CTA copy, since both live
/// inside this same section's component rather than becoming new top-level sections.
model AboutCompanyWhatWeDoSection {
  id                     String   @id @default(cuid())
  eyebrow                String   @default("What We Supply")
  heading                String   @default("Coconut Products for Global Markets")
  description            String   @default("From fresh coconuts to processed coconut-derived products, PPN supports international buyers with flexible sourcing, quality-focused handling, and export-oriented supply.")
  whoHeading             String   @default("Serving Buyers Across the Coconut Value Chain") @map("who_heading")
  whoDescription          String   @default("PPN works with businesses across the coconut supply chain, from international importers and manufacturers to distributors and industrial users.") @map("who_description")
  buyerCtaHeading        String   @default("Looking for Coconut Products?") @map("buyer_cta_heading")
  buyerCtaDescription    String   @default("Talk to the PPN team about product specifications, availability, packaging, volume requirements, and export destinations.") @map("buyer_cta_description")
  buyerCtaButtonText     String   @default("Explore Our Products") @map("buyer_cta_button_text")
  supplierCtaHeading     String   @default("Want to Supply PPN?") @map("supplier_cta_heading")
  supplierCtaDescription String   @default("We work with farmers, collectors, suppliers and long-term sourcing partners across Indonesia.") @map("supplier_cta_description")
  supplierCtaButtonText  String   @default("Our Supply Network") @map("supplier_cta_button_text")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for the text fields above.
  translations           Json?

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("about_company_what_we_do_section")
}

/// "Who We Supply" audience segments (Importers/Manufacturers/Distributors/Industrial Users/
/// Long-term Partners) — a flat repeatable list, not tied to any product or external record.
model WhoWeSupplyItem {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  /// Fixed icon-key allowlist (see `WHO_WE_SUPPLY_ICONS` in shared-types) — never raw markup or
  /// a remote asset URL.
  icon         String?
  order        Int      @default(0)
  active       Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title/description.
  translations Json?

  @@map("who_we_supply_items")
}

// Section 04 "Legal & Certificate" — fileId accepts a PDF or an image Media row (the existing
// Media model already distinguishes file_type; the Admin UI picks the right upload/preview
// treatment based on it). previewImageId is an optional separate thumbnail for a PDF document
// (a PDF has no native image preview), left unset for image-type documents.
enum LegalDocumentType {
  certificate
  legal_document
  business_license
  registration_document
  export_certificate
  quality_certificate
  other
}

/// Admin-managed document categories, replacing the fixed `LegalDocumentType` enum: the brief
/// requires add/edit/delete/reorder/activate, none of which an enum can do without a migration
/// per change. `documentType` is kept on the document as a read-only legacy column so existing
/// rows and published snapshots keep resolving while categories become the source of truth.
model LegalDocumentCategory {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  order        Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for name/description.
  translations Json?

  documents LegalCertificateDocument[]

  @@map("legal_document_categories")
}

model LegalCertificateDocument {
  id                  String                 @id @default(cuid())
  title               String
  documentType        LegalDocumentType      @default(other) @map("document_type")
  categoryId          String?                @map("category_id")
  category            LegalDocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Optional issuing country, shown next to the institution when set.
  country             String?
  /// Only ever true because an Admin ticked it — never inferred. Drives the public
  /// "Verified Document" badge, which must never be claimed automatically.
  verified            Boolean                @default(false)
  documentNumber      String?                @map("document_number")
  issuingOrganization String?                @map("issuing_organization")
  issueDate           DateTime?              @map("issue_date")
  expiryDate          DateTime?              @map("expiry_date")
  description         String?
  fileId              String?                @map("file_id")
  file                Media?                 @relation("LegalDocumentFile", fields: [fileId], references: [id])
  previewImageId      String?                @map("preview_image_id")
  previewImage        Media?                 @relation("LegalDocumentPreview", fields: [previewImageId], references: [id])
  order               Int                    @default(0)
  active              Boolean                @default(true)
  featured            Boolean                @default(false)
  updatedAt           DateTime               @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title/description.
  translations        Json?

  @@index([categoryId])
  @@index([active])
  @@map("legal_certificate_documents")
}

// Section 05 "Factory" — deliberately its own profile/gallery/documents, independent of the
// existing Facility model/Facilities page (client-confirmed): this is a distinct "our factory
// story" narrative inside About Company, not a duplicate of the dedicated Facilities module,
// which stays the place for full facility specs/photos.
model FactoryProfile {
  id                  String   @id @default(cuid())
  eyebrow             String   @default("Factory & Facilities")
  name                String   @default("Factory")
  shortDescription    String   @default("") @map("short_description")
  detailedDescription String   @default("") @map("detailed_description")
  location            String?
  operationalInfo     String?  @map("operational_info")
  capacity            String?
  additionalNotes     String?  @map("additional_notes")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for eyebrow/name/shortDescription/detailedDescription/location/operationalInfo/capacity/additionalNotes.
  translations        Json?

  gallery   FactoryGalleryImage[]
  documents FactoryDocument[]
  videos    FactoryVideo[]

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("factory_profile")
}

model FactoryGalleryImage {
  id        String         @id @default(cuid())
  factoryId String         @map("factory_id")
  factory   FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  mediaId   String         @map("media_id")
  media     Media          @relation("FactoryGalleryMedia", fields: [mediaId], references: [id])
  title     String?
  caption   String?
  category  String?
  altText   String?        @map("alt_text")
  order     Int            @default(0)
  featured  Boolean        @default(false)
  active    Boolean        @default(true)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([factoryId])
  @@index([active])
  @@map("factory_gallery")
}

// TikTok video showcase for the Factory section (brief: "PPN — ABOUT COMPANY FACTORY / FACILITIES
// FULL UI/UX + FRONTEND + ADMIN REDESIGN"). Admin only ever provides a TikTok URL — the official
// TikTok embed script renders the video client-side, so no thumbnail/video file is stored here.
model FactoryVideo {
  id          String         @id @default(cuid())
  factoryId   String         @map("factory_id")
  factory     FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  title       String
  tiktokUrl   String         @map("tiktok_url")
  description String?
  order       Int            @default(0)
  featured    Boolean        @default(false)
  active      Boolean        @default(true)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  @@map("factory_videos")
}

// Optional supporting PDFs for the Factory section — deliberately lighter than
// LegalCertificateDocument (no document type/issuer/dates): brief item 36 only asks for
// title + file + description for these.
model FactoryDocument {
  id          String         @id @default(cuid())
  factoryId   String         @map("factory_id")
  factory     FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  title       String
  fileId      String?        @map("file_id")
  file        Media?         @relation("FactoryDocumentFile", fields: [fileId], references: [id])
  description String?
  order       Int            @default(0)
  active      Boolean        @default(true)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  @@map("factory_documents")
}

/// Section 04's own heading copy plus its one behavioural setting (singleton).
model AboutCompanyLegalSection {
  id           String   @id @default(cuid())
  eyebrow      String   @default("Legal & Company Information")
  heading      String   @default("Trusted Compliance, Verified Documentation")
  description  String   @default("")
  /// Expired documents stay visible by default — hiding them is a business decision, so it is
  /// an explicit Admin choice rather than silent behaviour.
  hideExpired  Boolean  @default(false) @map("hide_expired")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for eyebrow/heading/description.
  translations Json?

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("about_company_legal_section")
}

// About Company page-level settings (singleton, get-or-create).
model AboutCompanySettings {
  id             String   @id @default(cuid())
  pageTitle      String   @default("About Us") @map("page_title")
  pageSubtitle   String   @default("") @map("page_subtitle")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  ogImageId      String?  @map("og_image_id")
  ogImage        Media?   @relation("AboutCompanySettingsOgImage", fields: [ogImageId], references: [id])
  visible        Boolean  @default(true)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("about_company_settings")
}

// ── Contact Page CMS (Post-Launch) ───────────────────────────────────────
// Dedicated Draft/Publish CMS for the public /contact page. Deliberately a separate data
// source from the generic `SiteSetting` key/value store (Footer keeps reading its own
// contact_email/whatsapp_number/social_* keys, untouched) and from the `/admin/kontak`
// Quotation inbox (an unrelated existing feature that just happens to share the word
// "Kontak"). See README "Contact Page — Full Redesign" for why these are intentionally two
// different systems rather than one shared source of truth.

enum ContactLocationType {
  head_office
  operational
  business
}

// Singleton draft row (get-or-create, same idiom as SiteBranding/AboutCompanySettings).
model ContactPageSettings {
  id String @id @default(cuid())

  email          String @default("")
  whatsappNumber String @default("") @map("whatsapp_number")

  /// Structured, not free text — lets the public page compute "open now" correctly instead
  /// of parsing a display string. Days are lowercase ISO weekday abbreviations (mon..sun);
  /// the human-readable "Monday–Saturday" label is derived from this list, never stored
  /// twice, so the two can never drift out of sync.
  businessHoursOpenDays  String[] @default(["mon", "tue", "wed", "thu", "fri", "sat"]) @map("business_hours_open_days")
  businessHoursOpenTime  String   @default("08:00") @map("business_hours_open_time")
  businessHoursCloseTime String   @default("17:00") @map("business_hours_close_time")
  businessHoursUtcOffset Int      @default(7) @map("business_hours_utc_offset")

  heroEyebrow          String  @default("Contact PPN") @map("hero_eyebrow")
  heroHeading          String  @default("Connect With Our Team") @map("hero_heading")
  heroDescription      String  @default("Whether you are an international buyer looking for reliable coconut products or a local supplier interested in working with PPN, our team is ready to connect with you.") @map("hero_description")
  heroImageId          String? @map("hero_image_id")
  heroImage            Media?  @relation("ContactHeroImage", fields: [heroImageId], references: [id])
  heroOverlayOpacity   Int     @default(55) @map("hero_overlay_opacity")
  heroCtaPrimaryText   String  @default("Talk to PPN") @map("hero_cta_primary_text")
  heroCtaSecondaryText String  @default("View Our Locations") @map("hero_cta_secondary_text")

  /// International-buyer conversion section ("Looking for Reliable Indonesian Coconut
  /// Supply?") — button always links to the existing /products page (brief §17: "existing
  /// Products page"), so only the copy is configurable, not a destination URL.
  buyerCtaHeading     String @default("Looking for Reliable Indonesian Coconut Supply?") @map("buyer_cta_heading")
  buyerCtaDescription String @default("Explore PPN's coconut products and connect with our export team for specifications, availability, and shipment requirements.") @map("buyer_cta_description")
  buyerCtaButtonText  String @default("Explore Our Products") @map("buyer_cta_button_text")

  /// Local-supplier conversion section ("Looking to Supply PPN?") — previously fixed dictionary
  /// copy, now Admin-editable including its own WhatsApp message (separate from the main
  /// buyer WhatsApp message above).
  supplierCtaHeading         String @default("Looking to Supply PPN?") @map("supplier_cta_heading")
  supplierCtaDescription     String @default("We welcome farmers, collectors, suppliers, and long-term supply partners interested in building reliable coconut supply partnerships with PPN.") @map("supplier_cta_description")
  supplierCtaButtonText      String @default("Talk to Our Supply Team") @map("supplier_cta_button_text")
  supplierCtaWhatsappMessage String @default("Hello PPN Team,\n\nI am interested in becoming a supplier / supply partner. I would like to know more about PPN's current coconut sourcing requirements, specifications, required volume, and supply process.\n\nThank you.") @map("supplier_cta_whatsapp_message")

  /// Main WhatsApp click-to-chat message, built from these four Admin-editable parts plus the
  /// real, live product catalog (never a stored list — see `buildWhatsAppMessage()` on the
  /// frontend) so the product names in the message can never drift from what's actually sold.
  /// Replaces what used to be hardcoded i18n dictionary strings.
  whatsappMessageGreeting         String @default("Hello PPN Team,") @map("whatsapp_message_greeting")
  whatsappMessageIntro            String @default("I am interested in PPN's coconut products. I would like to know more about your current product availability, specifications, MOQ, packaging options, pricing, and shipment terms.") @map("whatsapp_message_intro")
  whatsappMessageProductListLabel String @default("Products I am interested in:") @map("whatsapp_message_product_list_label")
  whatsappMessageClosing          String @default("Thank you.") @map("whatsapp_message_closing")

  mainMapLocationId String?          @map("main_map_location_id")
  mainMapLocation   ContactLocation? @relation("ContactMainMapLocation", fields: [mainMapLocationId], references: [id], onDelete: SetNull)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  /// i18n — non-English overrides for the hero copy and the WhatsApp message template, the
  /// only fields on this model actually rendered on the public site (P0.3-B3-B audit: every
  /// cta_* field is dead — removed from the Contact page per an earlier redesign request — and
  /// email/whatsapp_number/business_hours/main_map_location_id are operational, never
  /// translated). Never touched for cta_* unless/until those fields gain a real public
  /// consumer.
  translations Json?

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("contact_page_settings")
}

// Repeatable draft rows — Tolitoli / Palu / Surabaya today, but Admin can add/remove more.
model ContactLocation {
  id            String              @id @default(cuid())
  name          String
  locationType  ContactLocationType @default(operational) @map("location_type")
  /// Short descriptive label shown under the name, e.g. "Head Office", "Operational Location".
  label         String              @default("")
  address       String
  /// The exact "Open in Google Maps" destination the Admin supplies — never derived/guessed.
  googleMapsUrl String              @default("") @map("google_maps_url")
  phone         String?
  email         String?
  order         Int                 @default(0)
  active        Boolean             @default(true)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at")

  /// i18n — non-English overrides for `label` only (P0.3-B3-C). `name`/`address`/
  /// `googleMapsUrl`/`phone`/`email` stay global — same "only what's actually rendered gets
  /// translated" rule B3-B applied to `ContactPageSettings`.
  translations Json?

  mainMapSettingsOf ContactPageSettings[] @relation("ContactMainMapLocation")

  @@map("contact_locations")
}

/// Open-ended social platform list — replaces the previous four fixed
/// instagram/tiktok/facebook/linkedin columns on `ContactPageSettings` (migrated into rows
/// here, not deleted) so the Admin can add/remove/reorder any platform, including ones the
/// original four fixed slots never supported (YouTube, WhatsApp-as-social). Same shape as
/// `AboutCompanySocialLink`, but its own model — Contact's icon set is deliberately
/// self-contained and not shared with About Company's (see README).
model ContactSocialLink {
  id           String   @id @default(cuid())
  platform     String
  displayName  String   @map("display_name")
  url          String
  active       Boolean  @default(true)
  openInNewTab Boolean  @default(true) @map("open_in_new_tab")
  order        Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("contact_social_links")
}

/// Singleton published state (get-or-create) — deliberately NOT an append-only history table
/// like Homepage/About Company's snapshots: this brief's own QA checklist only asks for Save
/// Draft/Preview/Publish/Unpublish, never "restore an older version", so the simpler model
/// proportional to what's actually needed. `isPublished=false` is what makes Unpublish take
/// the public page down without deleting the last-known payload.
model ContactPagePublishedSnapshot {
  id          String    @id @default(cuid())
  isPublished Boolean   @default(false) @map("is_published")
  data        Json?
  publishedAt DateTime? @map("published_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("contact_page_published_snapshot")
}

// ── 3.18 Inner Page Header (Design → Inner Page Header) ────────────────────
// One row per `page_key`, plus a reserved "global-default" row. Every column below except
// `page_key`/`is_active` is intentionally nullable — resolution is a 3-tier field-by-field
// merge (page-specific → global-default → hardcoded system constant), not a whole-row
// override, so e.g. Facilities can set just a subtitle while its background/colors still
// inherit from Global. A page-specific row with `is_active=false` is skipped entirely, as if
// it didn't exist — the admin's per-page "Active" toggle. Pages with no configured background
// anywhere in the chain render PageHeader.tsx's original plain flat background unchanged (see
// README "Inner Page Header" — this is what keeps every page's current appearance identical
// the day this table is introduced, until an admin deliberately uploads something).
enum PageHeaderOverlayType {
  dark
  light
  green
  gradient
}

enum PageHeaderPosition {
  center
  center_top
  center_bottom
  left
  right
}

enum PageHeaderHeightPreset {
  compact
  standard
  tall
}

model PageHeader {
  id       String  @id @default(cuid())
  pageKey  String  @unique @map("page_key")
  isActive Boolean @default(true) @map("is_active")

  backgroundImageId String? @map("background_image_id")
  backgroundImage    Media? @relation("PageHeaderBackgroundImage", fields: [backgroundImageId], references: [id])
  mobileBackgroundImageId String? @map("mobile_background_image_id")
  mobileBackgroundImage    Media? @relation("PageHeaderMobileBackgroundImage", fields: [mobileBackgroundImageId], references: [id])
  /// Falls back to the resolved page title when left blank (NFR-A11Y-03).
  altText String? @map("alt_text")

  /// Only meaningful on page-specific rows — deliberately not read from the global-default row
  /// (a global title override applying to every page at once would be confusing, not useful).
  customTitle String? @map("custom_title")
  subtitle    String?

  overlayEnabled Boolean?               @map("overlay_enabled")
  overlayType    PageHeaderOverlayType? @map("overlay_type")
  overlayOpacity Int?                   @map("overlay_opacity")

  backgroundPosition       PageHeaderPosition? @map("background_position")
  mobileBackgroundPosition PageHeaderPosition? @map("mobile_background_position")

  heightPreset PageHeaderHeightPreset? @map("height_preset")

  titleColor      String? @map("title_color")
  subtitleColor   String? @map("subtitle_color")
  breadcrumbColor String? @map("breadcrumb_color")

  showBreadcrumb Boolean? @map("show_breadcrumb")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  /// i18n — non-English overrides for customTitle/subtitle. Never read for the reserved
  /// "global-default" row (see `customTitle`'s own comment above — a global title override
  /// applying to every page at once isn't meaningful), same as `customTitle` itself.
  translations Json?

  @@map("page_headers")
}

// ── 3.19 Footer (Settings → Footer Management) ─────────────────────────────
// Singleton (get-or-create), matching SiteBranding/ContactPageSettings. Deliberately does NOT
// duplicate contact info, business hours, social links, or office locations — those are already
// real, admin-editable data on ContactPageSettings/ContactLocation/ContactSocialLink (see
// README "Contact Page — Full Redesign"), and the Footer reads that same published payload
// directly. This model only owns what's genuinely footer-specific: enable/disable toggles,
// brand-area copy, the background photo treatment, and the closing CTA card copy. Reuses
// `PageHeaderPosition` (already generic — center/center_top/center_bottom/left/right) rather
// than a duplicate enum.
enum FooterOverlayType {
  dark_green
  charcoal
  black
  green_gradient
}

model FooterSettings {
  id String @id @default(cuid())

  enabled        Boolean @default(true)
  showCta        Boolean @default(true) @map("show_cta")
  showSocial     Boolean @default(true) @map("show_social")
  showContact    Boolean @default(true) @map("show_contact")
  showNavigation Boolean @default(true) @map("show_navigation")

  companyName String @default("CV. Putri Palma Nusantara") @map("company_name")
  tagline     String @default("Coconut Products for Global Markets")
  description String @default("Indonesian coconut products sourced, handled, and supplied for local and international markets.")

  backgroundImageId String? @map("background_image_id")
  backgroundImage   Media?  @relation("FooterBackgroundImage", fields: [backgroundImageId], references: [id])
  mobileBackgroundImageId String? @map("mobile_background_image_id")
  mobileBackgroundImage   Media?  @relation("FooterMobileBackgroundImage", fields: [mobileBackgroundImageId], references: [id])
  /// Falls back to companyName when left blank (NFR-A11Y-03).
  backgroundAltText String? @map("background_alt_text")

  overlayType    FooterOverlayType  @default(dark_green) @map("overlay_type")
  overlayOpacity Int                @default(70) @map("overlay_opacity")

  backgroundPosition       PageHeaderPosition @default(center) @map("background_position")
  mobileBackgroundPosition PageHeaderPosition @default(center) @map("mobile_background_position")

  ctaHeadline      String @default("Ready to Source from Indonesia?") @map("cta_headline")
  ctaDescription   String @default("Talk to our team about product specifications, volume requirements, and shipment arrangements.") @map("cta_description")
  ctaPrimaryText   String @default("Explore Products") @map("cta_primary_text")
  ctaSecondaryText String @default("Talk to PPN") @map("cta_secondary_text")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  /// i18n — non-English overrides for tagline/description/cta_headline/cta_description/
  /// cta_primary_text/cta_secondary_text — every marketing-copy field on this model that's
  /// actually rendered publicly (P2-4: cta_* gained its first public consumer, the Footer CTA
  /// row). company_name/media/toggles/colors are global, not per-locale.
  translations Json?

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("footer_settings")
}

// ── 3.20 AI Assistant ───────────────────────────────────────────────────────
// Retrieval-based (RAG) assistant — CMS content is the single source of truth; this whole
// section is DERIVED/indexed data, never hand-authored. See README "AI Assistant" for the full
// architecture note. Retrieval uses PostgreSQL's built-in full-text search (`to_tsvector`/
// `ts_rank`, no extension required) rather than vector embeddings: pgvector was confirmed
// available-but-not-installed on the dev database and its availability can't be assumed on
// whatever Postgres this eventually deploys to, whereas `tsvector` ships with every Postgres
// install — zero infra risk for a knowledge base this size (a company profile site, not a
// large document corpus). Known trade-off, stated plainly: the `simple` text search config used
// here tokenizes on whitespace/punctuation with no per-language stemming, and Chinese/Thai
// (which don't use whitespace between words) get materially lower retrieval precision than the
// space-separated languages — full CJK/Thai segmentation would need a dedicated extension
// (e.g. zhparser) not available on this database.

// Singleton (get-or-create), matching SiteBranding/FooterSettings. The 11 `include*` toggles
// mirror exactly what Admin → AI Assistant → Knowledge lets an admin turn on/off; they gate
// which CMS modules `AiSyncService` reads from on each rebuild — nothing else. `businessInstructions`
// is the ONLY admin-editable addition to the system prompt; core anti-hallucination/safety rules
// are hardcoded in `ai-system-prompt.ts` and never admin-editable (brief requirement).
model AiSettings {
  id String @id @default(cuid())

  enabled       Boolean @default(true)
  assistantName String  @default("PPN Assistant") @map("assistant_name")
  subtitle      String  @default("Your Coconut Supply Assistant")
  desktopEnabled Boolean @default(true) @map("desktop_enabled")
  mobileEnabled  Boolean @default(true) @map("mobile_enabled")

  /// Additive business context appended to the (protected, hardcoded) core system prompt —
  /// e.g. "Always present PPN as a professional Indonesian coconut supplier." Never overrides
  /// the anti-hallucination rules.
  businessInstructions String @default("") @map("business_instructions")

  includeHome              Boolean @default(true) @map("include_home")
  includeAboutCompany      Boolean @default(true) @map("include_about_company")
  includeProducts          Boolean @default(true) @map("include_products")
  includeFacilities        Boolean @default(true) @map("include_facilities")
  includeMoqPaymentTerms   Boolean @default(true) @map("include_moq_payment_terms")
  includeShipmentTerms     Boolean @default(true) @map("include_shipment_terms")
  includeFaq               Boolean @default(true) @map("include_faq")
  includeGallery           Boolean @default(true) @map("include_gallery")
  includeNews              Boolean @default(true) @map("include_news")
  includeContact           Boolean @default(true) @map("include_contact")
  includeLegalCertificates Boolean @default(true) @map("include_legal_certificates")

  whatsappEnabled           Boolean @default(true) @map("whatsapp_enabled")
  whatsappNumber             String  @default("+6282293807717") @map("whatsapp_number")
  whatsappDisplayName        String  @default("PPN Team") @map("whatsapp_display_name")
  whatsappGeneralMessage     String  @default("Hello PPN Team,\n\nI am interested in your coconut products.\n\nProduct:\nQuantity:\nDestination:\n\nI would like to request product information and quotation.\n\nThank you.") @map("whatsapp_general_message")
  whatsappProductMessage     String  @default("Hello PPN Team,\n\nI am interested in {product}.\n\nI would like to know more about:\n- Product specifications\n- Packaging\n- Availability\n- Pricing\n- Shipment options\n\nQuantity:\nDestination:\n\nThank you.") @map("whatsapp_product_message")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("ai_settings")
}

/// One admin-toggle group per row of `AiSettings`'s `include*` fields — the coarse grouping the
/// Knowledge Status admin screen and per-source counts are reported against.
enum AiSourceKey {
  home
  about_company
  products
  facilities
  moq_payment_terms
  shipment_terms
  faq
  gallery
  news
  contact
  legal_certificates
}

/// A retrieval-ready chunk of PUBLISHED website content — never hand-authored, always produced
/// by `AiSyncService` from the same public read paths the website itself renders through (see
/// README "AI Assistant" for the exact source-per-module table). `version` is a rebuild
/// timestamp (ms epoch): every full resync writes an entirely new set of rows tagged with a
/// fresh version inside one transaction, and only flips `AiSyncStatus.activeVersion` to point at
/// it after every row commits — so a failed/partial rebuild can never take the live knowledge
/// base down (README "AI Assistant" §Version Control). Old versions are deleted lazily by the
/// next successful sync, not deactivated-in-place, keeping exactly one live generation of rows
/// per language at rest.
model AiKnowledgeChunk {
  id          String      @id @default(cuid())
  version     BigInt
  sourceKey   AiSourceKey @map("source_key")
  contentType String      @map("content_type")
  page        String
  section     String?
  language    String
  productId   String?     @map("product_id")
  sourceUrl   String      @map("source_url")
  content     String
  updatedAt   DateTime    @map("updated_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  /// Generated/stored column (`to_tsvector('simple', content)`) + GIN index, added by raw SQL
  /// in the migration — Prisma only needs to know this column exists so it never tries to drop
  /// it on a future `migrate dev`; all querying against it happens via `$queryRaw`.
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([version, language])
  @@index([sourceKey, language])
  @@index([productId])
  @@map("ai_knowledge_chunks")
}

enum AiSyncRunStatus {
  running
  success
  failed
}

/// Singleton — the current live state the Knowledge Status admin screen reads. `activeVersion`
/// is the only pointer the chat retrieval query actually filters on; every other field here is
/// purely for admin visibility.
model AiSyncStatus {
  id             String          @id @default(cuid())
  activeVersion  BigInt?         @map("active_version")
  lastSyncedAt   DateTime?       @map("last_synced_at")
  lastStatus     AiSyncRunStatus @default(success) @map("last_status")
  lastError      String?         @map("last_error")
  totalSources   Int             @default(0) @map("total_sources")
  indexedCount   Int             @default(0) @map("indexed_count")
  failedCount    Int             @default(0) @map("failed_count")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")

  /// P1-6 — always `true`; the `@unique` constraint below makes a second row for this
  /// singleton impossible at the database level (defense-in-depth against the classic
  /// findFirst()-then-create() TOCTOU race two concurrent admin requests could otherwise hit).
  singleton Boolean @unique @default(true)

  @@map("ai_sync_status")
}

/// Append-only — the admin's sync history / activity log (brief §AG "Activity Log").
model AiSyncLog {
  id            String          @id @default(cuid())
  version       BigInt
  status        AiSyncRunStatus
  trigger       String
  startedAt     DateTime        @default(now()) @map("started_at")
  finishedAt    DateTime?       @map("finished_at")
  chunksCreated Int             @default(0) @map("chunks_created")
  errorMessage  String?         @map("error_message")

  @@index([startedAt])
  @@map("ai_sync_logs")
}

/// Admin-managed shortcut prompts shown in the chat window's welcome screen — NOT a
/// question/answer knowledge database (brief §M: "Quick questions hanya shortcut untuk
/// mengirim pertanyaan ke AI"). Clicking one just submits `question` as a normal chat message;
/// the AI still answers it via the same retrieval pipeline as free-typed questions.
model AiQuickQuestion {
  id        String   @id @default(cuid())
  label     String
  question  String
  language  String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([language, active, order])
  @@map("ai_quick_questions")
}

enum AiMessageRole {
  user
  assistant
}

/// Minimal conversation log (brief §AA privacy note: session_id + timestamp + language +
/// message/response metadata, nothing visitor-identifying beyond the ephemeral session id —
/// no IP, no user agent, no cross-session tracking). `content` is retained (buyer product
/// questions aren't sensitive personal data) so Admin → Test AI / conversation review and
/// multi-turn context can both read real history; nothing beyond `sessionId` ties a row to a
/// person, and `sessionId` itself is a random per-browser-session value, not an account id.
model AiConversationMessage {
  id            String        @id @default(cuid())
  sessionId     String        @map("session_id")
  role          AiMessageRole
  content       String
  language      String
  pageContext   String?       @map("page_context")
  productId     String?       @map("product_id")
  sourcesUsed   Int           @default(0) @map("sources_used")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("ai_conversation_messages")
}

enum AiAnalyticsEventType {
  chat_opened
  question_submitted
  quick_question_clicked
  quotation_intent
  whatsapp_clicked
}

/// Privacy-conscious usage counters (brief §AI) — event type + coarse dimensions only, no raw
/// message content, no visitor-identifying data beyond the same ephemeral `sessionId`.
model AiAnalyticsEvent {
  id        String               @id @default(cuid())
  eventType AiAnalyticsEventType @map("event_type")
  sessionId String               @map("session_id")
  language  String?
  productId String?              @map("product_id")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@map("ai_analytics_events")
}
