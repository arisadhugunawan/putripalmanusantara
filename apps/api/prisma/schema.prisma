  buyerCtaHeading     String @default("Looking for Reliable Indonesian Coconut Supply?") @map("buyer_cta_heading")
  buyerCtaDescription String @default("Explore PPN's coconut products and connect with our export team for specifications, availability, and shipment requirements.") @map("buyer_cta_description")
  buyerCtaButtonText  String @default("Explore Our Products") @map("buyer_cta_button_text")

