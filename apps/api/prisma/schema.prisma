// Prisma schema — implements docs/04-database.md as a physical PostgreSQL schema.
// Every model below maps 1:1 to a section in that document; see the comment above each
// model for the matching section number.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── 3.1 Admin ────────────────────────────────────────────────────────────
// Sole system role (docs/01-prd.md §6.2 — no public/buyer login).
enum AdminRole {
  super_admin
  editor
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(editor)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

// ── 3.14 Media ───────────────────────────────────────────────────────────
enum MediaFileType {
  image
  video
  pdf
}

model Media {
  id         String        @id @default(cuid())
  fileUrl    String        @map("file_url")
  fileType   MediaFileType @map("file_type")
  altText    String        @map("alt_text")
  width      Int?
  height     Int?
  uploadedAt DateTime      @default(now()) @map("uploaded_at")
  /// i18n — non-English alt_text overrides, e.g. {"id": {"altText": "..."}, "zh": {...}}.
  /// English (altText above) stays the untouched source of truth; see README
  /// "Internationalization" section.
  translations Json?

  productsAsCover      Product[]                      @relation("ProductCoverImage")
  productGalleryItems  ProductGalleryImage[]
  packagingApps        ProductPackagingApplication[]
  articlesAsCover      Article[]                      @relation("ArticleCoverImage")
  galleryItems         GalleryItem[]
  facilitiesAsCover    Facility[]                     @relation("FacilityCoverImage")
  facilityGalleryItems FacilityGalleryImage[]
  productionSteps      ProductionStep[]
  heroSlidesAsDesktop  HeroSlide[]                    @relation("HeroSlideDesktopImage")
  heroSlidesAsMobile   HeroSlide[]                    @relation("HeroSlideMobileImage")
  partnerLogos         PartnerLogo[]
  aboutPreviewVideos   HomepageAboutPreview[]          @relation("AboutPreviewVideoMedia")
  aboutPreviewThumbs   HomepageAboutPreview[]          @relation("AboutPreviewVideoThumbnail")

  @@index([fileType])
  @@map("media")
}

// ── 3.2–3.6 Product & related ───────────────────────────────────────────
enum ContentStatus {
  draft
  published
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  category         String
  shortDescription String        @map("short_description")
  fullDescription  String        @map("full_description")
  coverImageId     String?       @map("cover_image_id")
  coverImage       Media?        @relation("ProductCoverImage", fields: [coverImageId], references: [id])
  metaTitle        String?       @map("meta_title")
  metaDescription  String?       @map("meta_description")
  isFeatured       Boolean       @default(false) @map("is_featured")
  status           ContentStatus @default(draft)
  order            Int           @default(0)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  /// i18n — non-English overrides for name/category/shortDescription/fullDescription/
  /// metaTitle/metaDescription, e.g. {"id": {"name": "...", ...}, "zh": {...}}.
  translations     Json?

  gallery           ProductGalleryImage[]
  specifications    ProductSpecification[]
  packagingAndApps  ProductPackagingApplication[]
  downloads         ProductDownload[]
  quotationRequests QuotationRequest[]

  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

model ProductGalleryImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String  @map("media_id")
  media     Media   @relation(fields: [mediaId], references: [id])
  order     Int     @default(0)

  @@map("product_gallery")
}

/// Distinguishes physical/technical spec cards from commercial export-terms cards on the
/// product detail page (Section 5 "Specifications" vs Section 9 "Export Information") —
/// both stored in the same flexible key/value table rather than a new model.
enum ProductSpecificationGroup {
  specification
  export_info
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  specKey   String  @map("spec_key")
  specValue String  @map("spec_value")
  order     Int     @default(0)
  group     ProductSpecificationGroup @default(specification)
  /// i18n — non-English overrides for specKey/specValue.
  translations Json?

  @@map("product_specifications")
}

enum PackagingApplicationType {
  packaging
  application
}

model ProductPackagingApplication {
  id          String                   @id @default(cuid())
  productId   String                   @map("product_id")
  product     Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        PackagingApplicationType
  title       String
  description String
  mediaId     String?                  @map("media_id")
  media       Media?                   @relation(fields: [mediaId], references: [id])
  /// i18n — non-English overrides for title/description.
  translations Json?

  @@map("product_packaging_applications")
}

model ProductDownload {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("product_downloads")
}

// ── 3.7 Article ──────────────────────────────────────────────────────────
model Article {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String
  content         String
  coverImageId    String?       @map("cover_image_id")
  coverImage      Media?        @relation("ArticleCoverImage", fields: [coverImageId], references: [id])
  category        String?
  author          String        @default("CV Putri Palma Nusantara")
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  status          ContentStatus @default(draft)
  publishedAt     DateTime?     @map("published_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title/excerpt/content/metaTitle/metaDescription/category.
  translations    Json?

  @@index([status])
  @@index([publishedAt])
  @@map("articles")
}

// ── 3.8 GalleryItem ─────────────────────────────────────────────────────
enum GalleryCategory {
  product
  facility
  production
  drone
}

model GalleryItem {
  id       String          @id @default(cuid())
  mediaId  String          @map("media_id")
  media    Media           @relation(fields: [mediaId], references: [id])
  category GalleryCategory
  caption  String?
  order    Int             @default(0)
  /// i18n — non-English override for caption.
  translations Json?

  @@index([category])
  @@map("gallery_items")
}

// ── 3.9 Facility ─────────────────────────────────────────────────────────
model Facility {
  id           String   @id @default(cuid())
  name         String
  description  String
  coverImageId String?  @map("cover_image_id")
  coverImage   Media?   @relation("FacilityCoverImage", fields: [coverImageId], references: [id])
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  /// i18n — non-English overrides for name/description.
  translations Json?

  gallery FacilityGalleryImage[]

  @@map("facilities")
}

// Join table implementing the ERD relation "FACILITY ||--o{ MEDIA : memiliki galeri"
// (docs/04-database.md §2) — FR-FAC-02 requires a facility to have a photo gallery,
// not just a single cover image.
model FacilityGalleryImage {
  id         String   @id @default(cuid())
  facilityId String   @map("facility_id")
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  mediaId    String   @map("media_id")
  media      Media    @relation(fields: [mediaId], references: [id])
  order      Int      @default(0)

  @@map("facility_gallery")
}

// ── 3.10 ProductionStep ─────────────────────────────────────────────────
model ProductionStep {
  id             String @id @default(cuid())
  title          String
  description    String
  illustrationId String? @map("icon_or_image_id")
  illustration   Media?  @relation(fields: [illustrationId], references: [id])
  order          Int     @default(0)
  /// i18n — non-English overrides for title/description.
  translations   Json?

  @@map("production_steps")
}

// ── 3.11 HomepageStatistic ──────────────────────────────────────────────
model HomepageStatistic {
  id    String  @id @default(cuid())
  label String
  value String
  icon  String?
  order Int     @default(0)
  /// i18n — non-English overrides for label/value.
  translations Json?

  @@map("homepage_statistics")
}

// ── 3.11a HeroSlide (Post-Launch) ────────────────────────────────────────
// Homepage hero carousel — fully admin-managed; zero rows is a valid state (public site
// falls back to a single static slide, see apps/web HeroSlider.tsx).
model HeroSlide {
  id              String    @id @default(cuid())
  desktopImageId  String?   @map("desktop_image_id")
  desktopImage    Media?    @relation("HeroSlideDesktopImage", fields: [desktopImageId], references: [id])
  mobileImageId   String?   @map("mobile_image_id")
  mobileImage     Media?    @relation("HeroSlideMobileImage", fields: [mobileImageId], references: [id])
  heading         String
  subheading      String
  button1Text     String?   @map("button_1_text")
  button1Link     String?   @map("button_1_link")
  button2Text     String?   @map("button_2_text")
  button2Link     String?   @map("button_2_link")
  order           Int       @default(0)
  enabled         Boolean   @default(true)
  publishDate     DateTime? @map("publish_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  /// i18n — non-English overrides for heading/subheading/button1Text/button2Text.
  translations    Json?

  @@map("hero_slides")
}

// ── 3.11b PartnerLogo (Post-Launch) ──────────────────────────────────────
// Trusted-partners marquee — zero rows is a valid, honest state (no real partnership URLs,
// institution names, or logo files are seeded — see README "Trusted Institutions & Partners
// Section Upgrade"). `category` is a free-text field, not an enum: the brief explicitly asks
// for admin-extensible categories, which a Prisma enum can't do without a migration.
model PartnerLogo {
  id           String   @id @default(cuid())
  logoId       String   @map("logo_id")
  logo         Media    @relation(fields: [logoId], references: [id])
  partnerName  String   @map("partner_name")
  description  String?
  websiteUrl   String?  @map("website_url")
  openInNewTab Boolean  @default(true) @map("open_in_new_tab")
  altText      String?  @map("alt_text")
  category     String   @default("Other")
  order        Int      @default(0)
  enabled      Boolean  @default(true)
  featured     Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  /// i18n — non-English overrides for partnerName/description.
  translations Json?

  @@map("partner_logos")
}

// ── 3.11f HomepagePartnersSection (Post-Launch) ──────────────────────────
// Singleton — the "Trusted Institutions & Partners" section's own title/subtitle/marquee
// speed, editable independently of the individual logos.
model HomepagePartnersSection {
  id                     String   @id @default(cuid())
  title                  String   @default("TRUSTED INSTITUTIONS & PARTNERS")
  subtitle               String   @default("Supporting our commitment to quality, compliance, and reliable international trade.")
  marqueeDurationSeconds Int      @default(40) @map("marquee_duration_seconds")
  enabled                Boolean  @default(true)
  updatedAt              DateTime @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title/subtitle.
  translations           Json?

  @@map("homepage_partners_section")
}

// ── 3.11c DecorativeGraphic (Post-Launch) ────────────────────────────────
// Low-opacity watermark line-art (built-in SVG variants, not uploaded photos). `page`
// scopes an element to a route (only "home" is rendered today — see README for why the
// brief's site-wide placement plan was narrowed to the Homepage).
enum DecorativeGraphicVariant {
  leaf_outline
  coconut_cross_section
  ship_outline
  compass
  world_map_outline
  palm_leaf
  coconut_tree_silhouette
  container_outline
}

enum DecorativeGraphicPlacement {
  hero_behind_content
  top_left
  top_right
  bottom_left
  bottom_right
  center_background
}

model DecorativeGraphic {
  id        String                     @id @default(cuid())
  page      String                     @default("home")
  variant   DecorativeGraphicVariant
  placement DecorativeGraphicPlacement
  opacity   Float                      @default(0.06)
  scale     Float                      @default(1)
  order     Int                        @default(0)
  enabled   Boolean                    @default(true)

  @@map("decorative_graphics")
}

// ── 3.11d HomepageAboutPreview (Post-Launch) ─────────────────────────────
// Singleton content block — the "About Company Preview" homepage section (intro copy +
// video). Service does get-or-create against a single well-known id, matching how the rest
// of the CMS avoids a dedicated "singleton" primitive. No video is seeded (video_source
// "none"): no real company video exists yet, so the section shows an honest placeholder
// until the admin adds one (see README — same rule as the Hero's un-supplied photos).
enum HomepageVideoSource {
  none
  youtube
  vimeo
  upload
}

model HomepageAboutPreview {
  id                String              @id @default(cuid())
  label             String              @default("About CV. Putri Palma Nusantara")
  heading           String              @default("Premium Indonesian Coconut Exporter")
  paragraph1        String              @default("")
  paragraph2        String              @default("")
  paragraph3        String              @default("")
  ctaText           String              @default("Get to Know Us") @map("cta_text")
  ctaLink           String              @default("/about") @map("cta_link")
  videoSource       HomepageVideoSource @default(none) @map("video_source")
  videoUrl          String?             @map("video_url")
  videoMediaId      String?             @map("video_media_id")
  videoMedia        Media?              @relation("AboutPreviewVideoMedia", fields: [videoMediaId], references: [id])
  videoThumbnailId  String?             @map("video_thumbnail_id")
  videoThumbnail    Media?              @relation("AboutPreviewVideoThumbnail", fields: [videoThumbnailId], references: [id])
  enabled           Boolean             @default(true)
  updatedAt         DateTime            @updatedAt @map("updated_at")
  /// i18n — non-English overrides for label/heading/paragraph1-3/ctaText.
  translations      Json?

  @@map("homepage_about_preview")
}

// ── 3.11e HomepageHighlight (Post-Launch) ────────────────────────────────
// The About Preview section's 4 "highlight" cards — a real list, unlike the singleton
// above, so it follows the normal per-item CRUD pattern (Facility/HeroSlide, etc.).
enum HomepageHighlightIcon {
  quality
  sustainability
  partnership
  service
  globe
  award
}

model HomepageHighlight {
  id           String                @id @default(cuid())
  icon         HomepageHighlightIcon @default(quality)
  title        String
  description  String
  order        Int                   @default(0)
  enabled      Boolean               @default(true)
  /// i18n — non-English overrides for title/description.
  translations Json?

  @@map("homepage_highlights")
}

// ── 3.11g HomepageWhyChooseUs (Post-Launch) ──────────────────────────────
// "Why Choose Us?" section — icon + short title only, deliberately no description field
// (the brief is explicit this section must never grow long-form copy). `enabled` and
// `featured` are two independent gates, same interpretation as PartnerLogo: `enabled` keeps
// the record on file/editable, `featured` is what actually publishes it to the Homepage.
enum HomepageWhyChooseUsIcon {
  quality
  supply
  export_ready
  consistency
  sustainability
  service
  pricing
  delivery
}

model HomepageWhyChooseUs {
  id           String                  @id @default(cuid())
  icon         HomepageWhyChooseUsIcon @default(quality)
  title        String
  order        Int                     @default(0)
  enabled      Boolean                 @default(true)
  featured     Boolean                 @default(true)
  /// i18n — non-English overrides for title.
  translations Json?

  @@map("homepage_why_choose_us")
}

// ── 3.12 FAQ ─────────────────────────────────────────────────────────────
model Faq {
  id       String        @id @default(cuid())
  question String
  answer   String
  order    Int           @default(0)
  status   ContentStatus @default(draft)
  /// i18n — non-English overrides for question/answer.
  translations Json?

  @@map("faqs")
}

// ── 3.13 QuotationRequest ───────────────────────────────────────────────
enum QuotationRequestType {
  quotation
  general_contact
}

enum QuotationRequestStatus {
  new
  in_progress
  done
}

model QuotationRequest {
  id                String                 @id @default(cuid())
  type              QuotationRequestType
  name              String
  company           String
  country           String
  email             String
  phone             String?
  productId         String?                @map("product_id")
  product           Product?               @relation(fields: [productId], references: [id])
  estimatedQuantity String?                @map("estimated_quantity")
  message           String
  status            QuotationRequestStatus @default(new)
  sourcePage        String                 @map("source_page")
  createdAt         DateTime               @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@index([productId])
  @@map("quotation_requests")
}

// ── 3.15 SiteSetting ─────────────────────────────────────────────────────
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  group String
  /// i18n — non-English overrides for value, e.g. {"id": {"value": "..."}, "zh": {...}}.
  translations Json?

  @@map("site_settings")
}
