# --- Database (docs/06-architecture.md §2) ---
DATABASE_URL="postgresql://USER@localhost:5432/ppn_dev?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- CORS: comma-separated list of allowed origins (public site + admin panel) ---
CORS_ORIGIN="http://localhost:3000"

# --- Admin JWT auth (docs/05-api.md §2, docs/06-architecture.md §6) ---
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"
JWT_COOKIE_NAME="ppn_admin_token"

# DEV-ONLY: set to "true" to skip the admin login form entirely (see JwtAuthGuard). Only
# takes effect when NODE_ENV is not "production". Leave unset/false by default.
ADMIN_AUTH_DISABLED="false"

# --- Rate limiting (docs/05-api.md §8) ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_FORM_MAX=5
RATE_LIMIT_FORM_WINDOW_MS=60000

# --- Media storage (docs/06-architecture.md §2) ---
# "local" for development (stored on disk under apps/api/uploads), "s3" for production.
MEDIA_STORAGE_DRIVER="local"
MEDIA_LOCAL_PUBLIC_URL="http://localhost:4000/uploads"

# S3-compatible object storage (Cloudflare R2 / AWS S3) — required when MEDIA_STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- Transactional email (docs/06-architecture.md §2, §11) ---
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="PPN Website <no-reply@ppn-example.com>"
ADMIN_NOTIFICATION_EMAIL="admin@ppn-example.com"

# --- On-demand ISR revalidation webhook (docs/06-architecture.md §4) ---
# Shared secret the API sends when calling the frontend's /api/revalidate route after CMS publish.
REVALIDATE_SECRET="change-me-to-a-long-random-secret"
WEB_APP_URL="http://localhost:3000"

# --- Instagram import (Insight & Articles → "Import from Instagram") ---
# Optional. When unset, the Import from Instagram flow validates the URL, checks for
# duplicates, and cleanly falls back to manual entry — automatic metadata fetch is simply
# unavailable. Instagram's oEmbed endpoint requires a Meta-issued access token (a Facebook
# App with Instagram Basic Display / oEmbed Read permission); scraping is not attempted.
INSTAGRAM_GRAPH_ACCESS_TOKEN=""

# --- Seed data (prisma/seed.ts) — used only to create the first Admin account ---
ADMIN_SEED_NAME="Admin PPN"
ADMIN_SEED_EMAIL="admin@ppn-example.com"
ADMIN_SEED_PASSWORD="change-me-strong-password"

# --- AI Assistant (PPN AI Assistant — RAG chat) ---
# Provider abstraction (`ai-provider.interface.ts`): only "anthropic" is implemented today, but
# the app never hard-codes the provider — swapping this later means adding one new class, not
# touching the chat service, retrieval, or frontend. Key is server-only, never sent to the
# frontend in any form. Leave ANTHROPIC_API_KEY unset to run everything (sync, admin, widget)
# except real chat replies, which fall back to the safe "assistant temporarily unavailable"
# message the brief itself specifies — the rest of the feature stays fully functional without a
# key.
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""
