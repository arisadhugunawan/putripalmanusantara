  mobileBackgroundPosition PageHeaderPosition @default(center) @map("mobile_background_position")

  ctaHeadline      String @default("Ready to Source from Indonesia?") @map("cta_headline")
  ctaDescription   String @default("Talk to our team about product specifications, volume requirements, and shipment arrangements.") @map("cta_description")
  ctaPrimaryText   String @default("Explore Products") @map("cta_primary_text")
  ctaSecondaryText String @default("Talk to PPN") @map("cta_secondary_text")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("footer_settings")
}

// ── 3.20 AI Assistant ───────────────────────────────────────────────────────
// Retrieval-based (RAG) assistant — CMS content is the single source of truth; this whole
// section is DERIVED/indexed data, never hand-authored. See README "AI Assistant" for the full
// architecture note. Retrieval uses PostgreSQL's built-in full-text search (`to_tsvector`/
// `ts_rank`, no extension required) rather than vector embeddings: pgvector was confirmed
// available-but-not-installed on the dev database and its availability can't be assumed on
// whatever Postgres this eventually deploys to, whereas `tsvector` ships with every Postgres
// install — zero infra risk for a knowledge base this size (a company profile site, not a
// large document corpus). Known trade-off, stated plainly: the `simple` text search config used
// here tokenizes on whitespace/punctuation with no per-language stemming, and Chinese/Thai
// (which don't use whitespace between words) get materially lower retrieval precision than the
// space-separated languages — full CJK/Thai segmentation would need a dedicated extension
// (e.g. zhparser) not available on this database.

// Singleton (get-or-create), matching SiteBranding/FooterSettings. The 11 `include*` toggles
// mirror exactly what Admin → AI Assistant → Knowledge lets an admin turn on/off; they gate
// which CMS modules `AiSyncService` reads from on each rebuild — nothing else. `businessInstructions`
// is the ONLY admin-editable addition to the system prompt; core anti-hallucination/safety rules
// are hardcoded in `ai-system-prompt.ts` and never admin-editable (brief requirement).
model AiSettings {
  id String @id @default(cuid())

  enabled       Boolean @default(true)
  assistantName String  @default("PPN Assistant") @map("assistant_name")
  subtitle      String  @default("Your Coconut Supply Assistant")
  desktopEnabled Boolean @default(true) @map("desktop_enabled")
  mobileEnabled  Boolean @default(true) @map("mobile_enabled")

  /// Additive business context appended to the (protected, hardcoded) core system prompt —
  /// e.g. "Always present PPN as a professional Indonesian coconut supplier." Never overrides
  /// the anti-hallucination rules.
  businessInstructions String @default("") @map("business_instructions")

  includeHome              Boolean @default(true) @map("include_home")
  includeAboutCompany      Boolean @default(true) @map("include_about_company")
  includeProducts          Boolean @default(true) @map("include_products")
  includeFacilities        Boolean @default(true) @map("include_facilities")
  includeMoqPaymentTerms   Boolean @default(true) @map("include_moq_payment_terms")
  includeShipmentTerms     Boolean @default(true) @map("include_shipment_terms")
  includeFaq               Boolean @default(true) @map("include_faq")
  includeGallery           Boolean @default(true) @map("include_gallery")
  includeNews              Boolean @default(true) @map("include_news")
  includeContact           Boolean @default(true) @map("include_contact")
  includeLegalCertificates Boolean @default(true) @map("include_legal_certificates")

  whatsappEnabled           Boolean @default(true) @map("whatsapp_enabled")
  whatsappNumber             String  @default("+6282293807717") @map("whatsapp_number")
  whatsappDisplayName        String  @default("PPN Team") @map("whatsapp_display_name")
  whatsappGeneralMessage     String  @default("Hello PPN Team,\n\nI am interested in your coconut products.\n\nProduct:\nQuantity:\nDestination:\n\nI would like to request product information and quotation.\n\nThank you.") @map("whatsapp_general_message")
  whatsappProductMessage     String  @default("Hello PPN Team,\n\nI am interested in {product}.\n\nI would like to know more about:\n- Product specifications\n- Packaging\n- Availability\n- Pricing\n- Shipment options\n\nQuantity:\nDestination:\n\nThank you.") @map("whatsapp_product_message")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ai_settings")
}

/// One admin-toggle group per row of `AiSettings`'s `include*` fields — the coarse grouping the
/// Knowledge Status admin screen and per-source counts are reported against.
enum AiSourceKey {
  home
  about_company
  products
  facilities
  moq_payment_terms
  shipment_terms
  faq
  gallery
  news
  contact
  legal_certificates
}

/// A retrieval-ready chunk of PUBLISHED website content — never hand-authored, always produced
/// by `AiSyncService` from the same public read paths the website itself renders through (see
/// README "AI Assistant" for the exact source-per-module table). `version` is a rebuild
/// timestamp (ms epoch): every full resync writes an entirely new set of rows tagged with a
/// fresh version inside one transaction, and only flips `AiSyncStatus.activeVersion` to point at
/// it after every row commits — so a failed/partial rebuild can never take the live knowledge
/// base down (README "AI Assistant" §Version Control). Old versions are deleted lazily by the
/// next successful sync, not deactivated-in-place, keeping exactly one live generation of rows
/// per language at rest.
model AiKnowledgeChunk {
  id          String      @id @default(cuid())
  version     BigInt
  sourceKey   AiSourceKey @map("source_key")
  contentType String      @map("content_type")
  page        String
  section     String?
  language    String
  productId   String?     @map("product_id")
  sourceUrl   String      @map("source_url")
  content     String
  updatedAt   DateTime    @map("updated_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  /// Generated/stored column (`to_tsvector('simple', content)`) + GIN index, added by raw SQL
  /// in the migration — Prisma only needs to know this column exists so it never tries to drop
  /// it on a future `migrate dev`; all querying against it happens via `$queryRaw`.
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([version, language])
  @@index([sourceKey, language])
  @@index([productId])
  @@map("ai_knowledge_chunks")
}

enum AiSyncRunStatus {
  running
  success
  failed
}

/// Singleton — the current live state the Knowledge Status admin screen reads. `activeVersion`
/// is the only pointer the chat retrieval query actually filters on; every other field here is
/// purely for admin visibility.
model AiSyncStatus {
  id             String          @id @default(cuid())
  activeVersion  BigInt?         @map("active_version")
  lastSyncedAt   DateTime?       @map("last_synced_at")
  lastStatus     AiSyncRunStatus @default(success) @map("last_status")
  lastError      String?         @map("last_error")
  totalSources   Int             @default(0) @map("total_sources")
  indexedCount   Int             @default(0) @map("indexed_count")
  failedCount    Int             @default(0) @map("failed_count")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")

  @@map("ai_sync_status")
}

/// Append-only — the admin's sync history / activity log (brief §AG "Activity Log").
model AiSyncLog {
  id            String          @id @default(cuid())
  version       BigInt
  status        AiSyncRunStatus
  trigger       String
  startedAt     DateTime        @default(now()) @map("started_at")
  finishedAt    DateTime?       @map("finished_at")
  chunksCreated Int             @default(0) @map("chunks_created")
  errorMessage  String?         @map("error_message")

  @@index([startedAt])
  @@map("ai_sync_logs")
}

/// Admin-managed shortcut prompts shown in the chat window's welcome screen — NOT a
/// question/answer knowledge database (brief §M: "Quick questions hanya shortcut untuk
/// mengirim pertanyaan ke AI"). Clicking one just submits `question` as a normal chat message;
/// the AI still answers it via the same retrieval pipeline as free-typed questions.
model AiQuickQuestion {
  id        String   @id @default(cuid())
  label     String
  question  String
  language  String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([language, active, order])
  @@map("ai_quick_questions")
}

enum AiMessageRole {
  user
  assistant
}

/// Minimal conversation log (brief §AA privacy note: session_id + timestamp + language +
/// message/response metadata, nothing visitor-identifying beyond the ephemeral session id —
/// no IP, no user agent, no cross-session tracking). `content` is retained (buyer product
/// questions aren't sensitive personal data) so Admin → Test AI / conversation review and
/// multi-turn context can both read real history; nothing beyond `sessionId` ties a row to a
/// person, and `sessionId` itself is a random per-browser-session value, not an account id.
model AiConversationMessage {
  id            String        @id @default(cuid())
  sessionId     String        @map("session_id")
  role          AiMessageRole
  content       String
  language      String
  pageContext   String?       @map("page_context")
  productId     String?       @map("product_id")
  sourcesUsed   Int           @default(0) @map("sources_used")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("ai_conversation_messages")
}

enum AiAnalyticsEventType {
  chat_opened
  question_submitted
  quick_question_clicked
  quotation_intent
  whatsapp_clicked
}

/// Privacy-conscious usage counters (brief §AI) — event type + coarse dimensions only, no raw
/// message content, no visitor-identifying data beyond the same ephemeral `sessionId`.
model AiAnalyticsEvent {
  id        String               @id @default(cuid())
  eventType AiAnalyticsEventType @map("event_type")
  sessionId String               @map("session_id")
  language  String?
  productId String?              @map("product_id")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@map("ai_analytics_events")
}
