  dark_green
  charcoal
  black
  green_gradient
}

model FooterSettings {
  id String @id @default(cuid())

  enabled        Boolean @default(true)
  showCta        Boolean @default(true) @map("show_cta")
  showSocial     Boolean @default(true) @map("show_social")
  showContact    Boolean @default(true) @map("show_contact")
  showNavigation Boolean @default(true) @map("show_navigation")

  companyName String @default("CV. Putri Palma Nusantara") @map("company_name")
  tagline     String @default("Coconut Products for Global Markets")
  description String @default("Indonesian coconut products sourced, handled, and supplied for local and international markets.")

  backgroundImageId String? @map("background_image_id")
  backgroundImage   Media?  @relation("FooterBackgroundImage", fields: [backgroundImageId], references: [id])
  mobileBackgroundImageId String? @map("mobile_background_image_id")
  mobileBackgroundImage   Media?  @relation("FooterMobileBackgroundImage", fields: [mobileBackgroundImageId], references: [id])
  /// Falls back to companyName when left blank (NFR-A11Y-03).
  backgroundAltText String? @map("background_alt_text")

  overlayType    FooterOverlayType  @default(dark_green) @map("overlay_type")
  overlayOpacity Int                @default(70) @map("overlay_opacity")

