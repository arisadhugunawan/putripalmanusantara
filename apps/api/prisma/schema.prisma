// ── 3.18 Inner Page Header (Design → Inner Page Header) ────────────────────
// One row per `page_key`, plus a reserved "global-default" row. Every column below except
// `page_key`/`is_active` is intentionally nullable — resolution is a 3-tier field-by-field
// merge (page-specific → global-default → hardcoded system constant), not a whole-row
// override, so e.g. Facilities can set just a subtitle while its background/colors still
// inherit from Global. A page-specific row with `is_active=false` is skipped entirely, as if
// it didn't exist — the admin's per-page "Active" toggle. Pages with no configured background
// anywhere in the chain render PageHeader.tsx's original plain flat background unchanged (see
// README "Inner Page Header" — this is what keeps every page's current appearance identical
// the day this table is introduced, until an admin deliberately uploads something).
enum PageHeaderOverlayType {
  dark
  light
  green
  gradient
}

enum PageHeaderPosition {
  center
  center_top
  center_bottom
  left
  right
}

enum PageHeaderHeightPreset {
  compact
  standard
  tall
}

model PageHeader {
  id       String  @id @default(cuid())
  pageKey  String  @unique @map("page_key")
  isActive Boolean @default(true) @map("is_active")

  backgroundImageId String? @map("background_image_id")
  backgroundImage    Media? @relation("PageHeaderBackgroundImage", fields: [backgroundImageId], references: [id])
  mobileBackgroundImageId String? @map("mobile_background_image_id")
  mobileBackgroundImage    Media? @relation("PageHeaderMobileBackgroundImage", fields: [mobileBackgroundImageId], references: [id])
  /// Falls back to the resolved page title when left blank (NFR-A11Y-03).
  altText String? @map("alt_text")

  /// Only meaningful on page-specific rows — deliberately not read from the global-default row
  /// (a global title override applying to every page at once would be confusing, not useful).
  customTitle String? @map("custom_title")
  subtitle    String?

  overlayEnabled Boolean?               @map("overlay_enabled")
  overlayType    PageHeaderOverlayType? @map("overlay_type")
  overlayOpacity Int?                   @map("overlay_opacity")

  backgroundPosition       PageHeaderPosition? @map("background_position")
  mobileBackgroundPosition PageHeaderPosition? @map("mobile_background_position")

  heightPreset PageHeaderHeightPreset? @map("height_preset")

  titleColor      String? @map("title_color")
  subtitleColor   String? @map("subtitle_color")
  breadcrumbColor String? @map("breadcrumb_color")

  showBreadcrumb Boolean? @map("show_breadcrumb")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  /// i18n — non-English overrides for customTitle/subtitle. Never read for the reserved
  /// "global-default" row (see `customTitle`'s own comment above — a global title override
  /// applying to every page at once isn't meaningful), same as `customTitle` itself.
  translations Json?

  @@map("page_headers")
}

// ── 3.19 Footer (Settings → Footer Management) ─────────────────────────────
// Singleton (get-or-create), matching SiteBranding/ContactPageSettings. Deliberately does NOT
// duplicate contact info, business hours, social links, or office locations — those are already
// real, admin-editable data on ContactPageSettings/ContactLocation/ContactSocialLink (see
// README "Contact Page — Full Redesign"), and the Footer reads that same published payload
// directly. This model only owns what's genuinely footer-specific: enable/disable toggles,
// brand-area copy, the background photo treatment, and the closing CTA card copy. Reuses
// `PageHeaderPosition` (already generic — center/center_top/center_bottom/left/right) rather
