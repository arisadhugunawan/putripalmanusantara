// ── 3.10c SupplyNetworkItem ───────────────────────────────────────────────
// Replaces "Why Choose Us?" (HomepageWhyChooseUs, kept untouched below for its data — just no
// longer wired into any Homepage rendering). Same shape family as ProductionStep. Redesigned
// (see README "Home → Our Supply Network") into a full admin-manageable ecosystem: each node
// carries a `shortTitle` (the small headline shown in its click/hover info panel — e.g. node
// "Farmers" → shortTitle "Local Farmer Network") and a `position` preset the frontend resolves
// into responsive coordinates (no pixel X/Y in the admin, per brief §29).
model SupplyNetworkItem {
  id             String   @id @default(cuid())
  label          String   @default("")
  title          String
  shortTitle     String   @default("") @map("short_title")
  description    String
  icon           String   @default("farmers")
  illustrationId String?  @map("illustration_id")
  illustration   Media?   @relation(fields: [illustrationId], references: [id])
  ctaLabel       String?  @map("cta_label")
  ctaHref        String?  @map("cta_href")
  /// One of: top, top_right, right, bottom_right, bottom, bottom_left, left, top_left.
  position       String   @default("top")
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for label/title/shortTitle/description.
  translations   Json?

  connectionsFrom SupplyNetworkConnection[] @relation("SupplyConnectionFrom")
  connectionsTo   SupplyNetworkConnection[] @relation("SupplyConnectionTo")

  @@map("supply_network_items")
}

// Admin-manageable "From Node → To Node" links (brief §30) — replaces the old frontend-computed
// hub-and-spoke positioning with explicit, CMS-owned connections the visual draws as animated
// curved paths.
model SupplyNetworkConnection {
  id         String            @id @default(cuid())
  fromNodeId String            @map("from_node_id")
  fromNode   SupplyNetworkItem @relation("SupplyConnectionFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String            @map("to_node_id")
  toNode     SupplyNetworkItem @relation("SupplyConnectionTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  order      Int               @default(0)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at")

  @@map("supply_network_connections")
}

// Destination markers for the section's subtle background "global trade" motif (brief §18/§32)
// — CMS-driven, not hardcoded, and deliberately just a name + flag + short status label, never
