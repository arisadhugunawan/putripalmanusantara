  articleId String   @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  mediaId   String   @map("media_id")
  media     Media    @relation("ArticleGalleryMedia", fields: [mediaId], references: [id])
  caption   String?
