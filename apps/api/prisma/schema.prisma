// ── 3.13 QuotationRequest ───────────────────────────────────────────────
enum QuotationRequestType {
  quotation
  general_contact
}

enum QuotationRequestStatus {
  new
  in_progress
  done
}

model QuotationRequest {
  id                  String                 @id @default(cuid())
  type                QuotationRequestType
  name                String
  company             String
  country             String
  email               String
  phone               String?
  productId           String?                @map("product_id")
  product             Product?               @relation(fields: [productId], references: [id])
  /// P2-2 — denormalized copy of Product.name at submission time, same reasoning as
  /// AdminActivityLog.actorName: history must stay readable even after the Product is deleted
  /// (productId → SET NULL on delete). Never touched after creation; the mapper only falls back
  /// to it when the live `product` relation is gone.
  productNameSnapshot String?                @map("product_name_snapshot")
  estimatedQuantity   String?                @map("estimated_quantity")
  message             String
  status              QuotationRequestStatus @default(new)
  sourcePage          String                 @map("source_page")
  createdAt           DateTime               @default(now()) @map("created_at")

  /// Database Implementation Plan Migration 3 — the CRM side of the existing public quotation
  /// flow. Purely virtual (no new column on this table): a QuotationRequest may become zero,
  /// one, or more Inquiry/Lead rows via their own nullable `sourceQuotationRequestId`, but this
  /// table itself is never modified by that conversion.
  inquiries Inquiry[]
  leads     Lead[]

  @@index([status])
  @@index([createdAt])
  @@index([productId])
  @@map("quotation_requests")
}

