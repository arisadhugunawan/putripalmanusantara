// Prisma schema — implements docs/04-database.md as a physical PostgreSQL schema.
// Every model below maps 1:1 to a section in that document; see the comment above each
// model for the matching section number.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── 3.1 Admin ────────────────────────────────────────────────────────────
// Sole system role (docs/01-prd.md §6.2 — no public/buyer login).
enum AdminRole {
  super_admin
  editor
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(editor)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

// Centralized admin audit trail — one row per mutating admin action, written by a global
// interceptor (`ActivityLogInterceptor`) rather than scattered per-service calls, so every
// current and future admin controller is covered automatically. Deliberately never stores
// request/response bodies (no secrets, tokens, or passwords ever land here) — only who did
// what to which entity, when, and with what outcome.
model AdminActivityLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  actorName  String   @map("actor_name")
  actorRole  String   @map("actor_role")
  action     String
  module     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  method     String
  path       String
  statusCode Int      @map("status_code")
  summary    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([module])
  @@map("admin_activity_logs")
}

// ── 3.14 Media ───────────────────────────────────────────────────────────
enum MediaFileType {
  image
  video
  pdf
}

model Media {
  id           String        @id @default(cuid())
  fileUrl      String        @map("file_url")
  fileType     MediaFileType @map("file_type")
  altText      String        @map("alt_text")
  width        Int?
  height       Int?
  /// Actual stored file size — captured at upload time (after any upload-time dimension cap
  /// is applied, so this reflects what's really on disk/in the bucket, not the pre-resize
  /// source). Null for rows uploaded before this column existed; the Media Library shows
  /// "—" rather than backfilling by re-fetching every historical file.
  sizeBytes    Int?          @map("size_bytes")
  uploadedAt   DateTime      @default(now()) @map("uploaded_at")
  /// Soft delete (Post-Launch Phase 3) — "Move to Trash" sets this instead of removing the
  /// row or the underlying file, so a mistaken delete is always recoverable and a file that
  /// only an old Product version snapshot still references (not a live relation, so the
  /// existing FK-based MEDIA_IN_USE guard can't see it) never silently disappears. Only
  /// `permanentDelete()` — which additionally checks snapshot history, not just live
  /// relations — actually removes the storage object and the row.
  deletedAt    DateTime?     @map("deleted_at")
  /// i18n — non-English alt_text overrides, e.g. {"id": {"altText": "..."}, "zh": {...}}.
  /// English (altText above) stays the untouched source of truth; see README
  /// "Internationalization" section.
  translations Json?

  productsAsCover               Product[]                     @relation("ProductCoverImage")
  productShapeMediaOf           ProductShape[]                @relation("ProductShapeMedia")
  productGalleryItems           ProductGalleryImage[]
  packagingApps                 ProductPackagingApplication[]
  articlesAsCover               Article[]                     @relation("ArticleCoverImage")
  galleryItems                  GalleryItem[]
  facilitiesAsCover             Facility[]                    @relation("FacilityCoverImage")
  facilityGalleryItems          FacilityGalleryImage[]
  productionSteps               ProductionStep[]
  supplyNetworkItems            SupplyNetworkItem[]
  heroSlidesAsDesktop           HeroSlide[]                   @relation("HeroSlideDesktopImage")
  heroSlidesAsMobile            HeroSlide[]                   @relation("HeroSlideMobileImage")
  partnerLogos                  PartnerLogo[]
  shippingPartners              ShippingPartner[]
  aboutPreviewVideos            HomepageAboutPreview[]        @relation("AboutPreviewVideoMedia")
  aboutPreviewThumbs            HomepageAboutPreview[]        @relation("AboutPreviewVideoThumbnail")
  brandingHeaderLogoOf          SiteBranding[]                @relation("SiteBrandingHeaderLogo")
  brandingFooterLogoOf          SiteBranding[]                @relation("SiteBrandingFooterLogo")
  brandingMobileLogoOf          SiteBranding[]                @relation("SiteBrandingMobileLogo")
  brandingFaviconOf             SiteBranding[]                @relation("SiteBrandingFavicon")
  brandingProductHeaderBgOf     SiteBranding[]                @relation("SiteBrandingProductHeaderBackground")
  contactHeroImageOf            ContactPageSettings[]         @relation("ContactHeroImage")
  aboutCompanyMainImageOf       AboutCompanyProfile[]         @relation("AboutCompanyMainImage")
  aboutCompanyStoryImageOf      AboutCompanyProfile[]         @relation("AboutCompanyStoryImage")
  aboutCompanyGalleryItems      AboutCompanyGalleryImage[]    @relation("AboutCompanyGalleryMedia")
  teamMemberPhotoOf             TeamMember[]                  @relation("TeamMemberPhoto")
  whatWeDoItems                 WhatWeDoItem[]                @relation("WhatWeDoMedia")
  legalDocumentFileOf           LegalCertificateDocument[]    @relation("LegalDocumentFile")
  legalDocumentPreviewOf        LegalCertificateDocument[]    @relation("LegalDocumentPreview")
  factoryGalleryItems           FactoryGalleryImage[]         @relation("FactoryGalleryMedia")
  factoryDocumentFileOf         FactoryDocument[]             @relation("FactoryDocumentFile")
  aboutCompanySettingsOgImageOf AboutCompanySettings[]        @relation("AboutCompanySettingsOgImage")
  articleGalleryItems           ArticleGalleryImage[]         @relation("ArticleGalleryMedia")
  articlesAsOgImage             Article[]                     @relation("ArticleOgImage")
  pageHeaderBackgroundOf        PageHeader[]                  @relation("PageHeaderBackgroundImage")
  pageHeaderMobileBackgroundOf  PageHeader[]                  @relation("PageHeaderMobileBackgroundImage")
  footerBackgroundOf            FooterSettings[]              @relation("FooterBackgroundImage")
  footerMobileBackgroundOf      FooterSettings[]              @relation("FooterMobileBackgroundImage")

  @@index([fileType])
  @@index([uploadedAt])
  @@index([deletedAt])
  @@map("media")
}

// ── 3.2–3.6 Product & related ───────────────────────────────────────────
enum ContentStatus {
  draft
  published
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  /// Optional leading portion of `name` to render in the brand accent colour on the detail
  /// page banner (e.g. name "Coconut Shisha Charcoal Briquette", titleAccent "Coconut Shisha").
  /// Must be an exact prefix of `name`; the public page falls back to a plain, single-colour
  /// title if it isn't (never guesses a split point — a wrong guess reads worse than none).
  titleAccent      String?       @map("title_accent")
  category         String
  shortDescription String        @map("short_description")
  fullDescription  String        @map("full_description")
  coverImageId     String?       @map("cover_image_id")
  coverImage       Media?        @relation("ProductCoverImage", fields: [coverImageId], references: [id])
  metaTitle        String?       @map("meta_title")
  metaDescription  String?       @map("meta_description")
  isFeatured       Boolean       @default(false) @map("is_featured")
  status           ContentStatus @default(draft)
  order            Int           @default(0)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  /// i18n — non-English overrides for name/category/shortDescription/fullDescription/
  /// metaTitle/metaDescription, e.g. {"id": {"name": "...", ...}, "zh": {...}}.
  translations     Json?

  /// Set only by publish()/restoreSnapshot() — never by ordinary update() — so it reflects
  /// exactly when the currently-live published snapshot was produced, independent of any
  /// draft edits made since. Denormalized alongside `snapshots` purely to avoid an extra query
  /// on every admin list/detail read just to show "Last published".
  lastPublishedAt DateTime? @map("last_published_at")

  gallery            ProductGalleryImage[]
  specifications     ProductSpecification[]
  packagingAndApps   ProductPackagingApplication[]
  downloads          ProductDownload[]
  quotationRequests  QuotationRequest[]
  exportDestinations ExportDestination[]           @relation("ExportDestinationProducts")
  whatWeDoItems      WhatWeDoItem[]                @relation("WhatWeDoProduct")
  shapes             ProductShape[]
  snapshots          ProductPublishedSnapshot[]

  @@index([status])
  @@index([isFeatured])
  @@index([order])
  @@map("products")
}

/// Append-only publish history for one Product — same `data: Json` snapshot idiom as
/// `AboutCompanyPublishedSnapshot`/`HomepagePublishedSnapshot` (the whole live row + every
/// relation serialized as one blob, re-mapped through the normal locale-aware mappers at read
/// time), scoped per-product with a per-product `version` counter since Products is a
/// collection of many independently-publishable items, not a single page/section. No
/// `onDelete: Cascade` on `productId` — deleting a Product with existing snapshots must fail
/// (default RESTRICT), never silently erase publish history; `ProductsService.remove()` turns
/// that FK violation into a clear 409, mirroring `MediaService.delete()`'s `MEDIA_IN_USE`
/// pattern. `publishedById`/`publishedByName` are plain denormalized strings, not a relation to
/// `Admin` — same reasoning as `AdminActivityLog`: history must stay readable even if the
/// admin account is later renamed or removed.
model ProductPublishedSnapshot {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id])
  version         Int
  data            Json
  publishedById   String   @map("published_by_id")
  publishedByName String   @map("published_by_name")
  publishedAt     DateTime @default(now()) @map("published_at")

  @@unique([productId, version])
  @@index([productId, publishedAt])
  @@map("product_published_snapshots")
}

/// Where a product media item is placed on the detail page. `spec_lab` items are the
/// specification sheet / laboratory report scans shown under "Specification & Lab. Test";
/// everything else is ordinary gallery media. Modelled as a placement flag on the existing
/// gallery rather than a second table so the Admin keeps one upload flow for product media.
enum ProductMediaSection {
  gallery
  spec_lab
}

model ProductGalleryImage {
  id        String              @id @default(cuid())
  productId String              @map("product_id")
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String              @map("media_id")
  /// May be an image *or* a video — `Media.fileType` already distinguishes them, and the
  /// public viewer plays video items instead of rendering them as stills.
  media     Media               @relation(fields: [mediaId], references: [id])
  section   ProductMediaSection @default(gallery)
  /// Optional caption shown under spec/lab documents (e.g. "Report of Analysis").
  caption   String?
  order     Int                 @default(0)

  @@map("product_gallery")
}

/// Distinguishes physical/technical spec cards from commercial export-terms cards on the
/// product detail page (Section 5 "Specifications" vs Section 9 "Export Information") —
/// both stored in the same flexible key/value table rather than a new model.
enum ProductSpecificationGroup {
  specification
  export_info
  /// Rendered as the "Detail Information" key/value table (MOQ, payment terms, …).
  detail_info
}

/// One shape/size option for a product — a shape name, a small reference photo, and the sizes
/// available in that shape. Sizes are free text, one per line, because their format differs per
/// product ("25x25x17 - (108 pcs/kg)", "18x50 - (72 pcs/kg)") and must stay exactly as the
/// Admin types it rather than being parsed into columns that may not fit every product.
model ProductShape {
  id           String  @id @default(cuid())
  productId    String  @map("product_id")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  mediaId      String? @map("media_id")
  media        Media?  @relation("ProductShapeMedia", fields: [mediaId], references: [id])
  sizes        String  @default("")
  order        Int     @default(0)
  /// i18n — non-English overrides for name/sizes.
  translations Json?

  @@map("product_shapes")
}

model ProductSpecification {
  id           String                    @id @default(cuid())
  productId    String                    @map("product_id")
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  specKey      String                    @map("spec_key")
  specValue    String                    @map("spec_value")
  order        Int                       @default(0)
  group        ProductSpecificationGroup @default(specification)
  /// Optional named sub-group within `group` (e.g. a product with several grades/variants —
  /// "Edible (White Copra)", "Regular (White Copra)" — each rendered as its own spec-sheet
  /// block instead of one flat mixed table). Null for the common case of one ungrouped set.
  variantLabel String?                   @map("variant_label")
  /// i18n — non-English overrides for specKey/specValue.
  translations Json?

  @@map("product_specifications")
}

enum PackagingApplicationType {
  packaging
  application
}

model ProductPackagingApplication {
  id           String                   @id @default(cuid())
  productId    String                   @map("product_id")
  product      Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         PackagingApplicationType
  title        String
  description  String
  mediaId      String?                  @map("media_id")
  media        Media?                   @relation(fields: [mediaId], references: [id])
  order        Int                      @default(0)
  /// i18n — non-English overrides for title/description.
  translations Json?

  @@map("product_packaging_applications")
}

model ProductDownload {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("product_downloads")
}

// ── 3.7 Article ──────────────────────────────────────────────────────────

/// Where an article's content originated — purely informational (drives the Admin's
/// "Instagram + Website" / "Website Only" / "Instagram Only" badge), never gates publishing.
enum ArticleContentSource {
  website
  instagram
  both
}

/// Admin-managed replacement for the free-text `Article.category` column, mirroring
/// `LegalDocumentCategory`'s enum→table upgrade: add/edit/delete/reorder/activate, none of
/// which a fixed list can do without a migration per change. The legacy `category` string on
/// `Article` is kept as a read-only fallback so articles written before this table existed
/// keep displaying their old category text.
model ArticleCategory {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  order        Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for name/description.
  translations Json?

  articles Article[]

  @@map("article_categories")
}

model ArticleGalleryImage {
  id        String   @id @default(cuid())
  articleId String   @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  mediaId   String   @map("media_id")
  media     Media    @relation("ArticleGalleryMedia", fields: [mediaId], references: [id])
  caption   String?
  altText   String?  @map("alt_text")
  order     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("article_gallery")
}

model Article {
  id            String               @id @default(cuid())
  slug          String               @unique
  title         String
  excerpt       String
  content       String
  coverImageId  String?              @map("cover_image_id")
  coverImage    Media?               @relation("ArticleCoverImage", fields: [coverImageId], references: [id])
  /// Legacy free-text category, kept only as a fallback for rows written before
  /// `ArticleCategory` existed — new/edited articles use `categoryId` instead.
  category      String?
  categoryId    String?              @map("category_id")
  categoryRef   ArticleCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          String[]             @default([])
  author        String               @default("CV Putri Palma Nusantara")
  featured      Boolean              @default(false)
  contentSource ArticleContentSource @default(website) @map("content_source")

  /// Instagram source content — kept separate from the website title/excerpt/content above
  /// (brief: "DO NOT simply copy the Instagram post exactly into the website"). Purely
  /// reference material for the Admin; never rendered as the article body.
  instagramCaption    String?   @map("instagram_caption")
  instagramUrl        String?   @map("instagram_url")
  instagramDate       DateTime? @map("instagram_date")
  instagramUsername   String?   @map("instagram_username")
  /// Shortcode extracted from the URL (e.g. "Cxyz123AbC") — used for duplicate-post detection
  /// independent of URL formatting (trailing slash, query string, /p/ vs /reel/).
  instagramPostId     String?   @map("instagram_post_id")
  /// Set only when metadata was actually fetched via the oEmbed import flow — null for
  /// manually-entered Instagram fields, so the Admin UI can tell the two apart.
  instagramImportedAt DateTime? @map("instagram_imported_at")

  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  canonicalUrl    String? @map("canonical_url")
  focusKeyword    String? @map("focus_keyword")
  ogImageId       String? @map("og_image_id")
  ogImage         Media?  @relation("ArticleOgImage", fields: [ogImageId], references: [id])

  /// Premium editorial detail-page blocks (all optional — the page degrades gracefully when
  /// unset). `readingTimeMinutes` overrides the auto-computed word-count estimate when set.
  keyTakeaways       String[] @default([]) @map("key_takeaways")
  quoteText          String?  @map("quote_text")
  quoteAuthor        String?  @map("quote_author")
  /// Array of {value, label} pairs, e.g. [{"value":"+20","label":"Export Markets"}].
  statistics         Json?
  readingTimeMinutes Int?     @map("reading_time_minutes")

  status       ContentStatus @default(draft)
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title/excerpt/content/metaTitle/metaDescription/category.
  translations Json?

  /// Set only by publish()/restoreSnapshot() — never by ordinary update() — so it reflects
  /// exactly when the currently-live published snapshot was produced, independent of any
  /// draft edits made since. Denormalized alongside `snapshots` purely to avoid an extra query
  /// on every admin list/detail read just to show "Last published". (P0.2b-A: column added,
  /// not yet written by publish()/restoreSnapshot() — those don't exist yet; see P0.2b-B.)
  lastPublishedAt DateTime? @map("last_published_at")

  galleryImages ArticleGalleryImage[]
  snapshots     ArticlePublishedSnapshot[]

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([instagramUrl])
  @@map("articles")
}

/// Append-only publish history for one Article — same `data: Json` snapshot idiom as
/// `ProductPublishedSnapshot`/`AboutCompanyPublishedSnapshot`/`HomepagePublishedSnapshot` (the
/// whole live row + every relation serialized as one blob, re-mapped through the normal
/// locale-aware mappers at read time), scoped per-article with a per-article `version` counter
/// since Articles is a collection of many independently-publishable items, not a single
/// page/section. No `onDelete: Cascade` on `articleId` — deleting an Article with existing
/// snapshots must fail (default RESTRICT), never silently erase publish history; a future
/// `ArticlesService.remove()` change should turn that FK violation into a clear 409, mirroring
/// `ProductsService.remove()`'s `PRODUCT_HAS_PUBLISHED_HISTORY` pattern (P0.2b-B, not this
/// phase). `publishedById`/`publishedByName` are plain denormalized strings, not a relation to
/// `Admin` — same reasoning as `AdminActivityLog`: history must stay readable even if the admin
/// account is later renamed or removed. (P0.2b-A: table + backfill only — nothing reads from
/// this table yet; the public API still reads the live `Article` row until P0.2b-B.)
model ArticlePublishedSnapshot {
  id              String   @id @default(cuid())
  articleId       String   @map("article_id")
  article         Article  @relation(fields: [articleId], references: [id])
  version         Int
  data            Json
  publishedById   String   @map("published_by_id")
  publishedByName String   @map("published_by_name")
  publishedAt     DateTime @default(now()) @map("published_at")

  @@unique([articleId, version])
  @@index([articleId, publishedAt])
  @@map("article_published_snapshots")
}

// ── 3.8 GalleryItem ─────────────────────────────────────────────────────
// Gallery — admin-manageable categories (PRODUCTS/TEAM are reserved slugs that render live data
// from the Products/Team modules on the frontend instead of carrying their own GalleryItem rows
// — see README "Gallery" for why these two are virtual rather than duplicating existing data).
model GalleryCategory {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  order        Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for name.
  translations Json?
  items        GalleryItem[]

  @@map("gallery_categories")
}

enum GalleryMediaType {
  image
  video
  youtube
  tiktok
}

model GalleryItem {
  id          String           @id @default(cuid())
  mediaType   GalleryMediaType @default(image) @map("media_type")
  /// Required for image/video, null for youtube/tiktok (those use externalUrl instead).
  mediaId     String?          @map("media_id")
  media       Media?           @relation(fields: [mediaId], references: [id])
  /// Required for youtube/tiktok, null for image/video.
  externalUrl String?          @map("external_url")
  categoryId  String           @map("category_id")
  category    GalleryCategory  @relation(fields: [categoryId], references: [id])

  title            String?
  caption          String?
  altText          String?   @map("alt_text")
  location         String?
  capturedAt       DateTime? @map("captured_at")
  shortDescription String?   @map("short_description")

  featured Boolean @default(false)
  active   Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title/caption/shortDescription.
  translations Json?

  @@index([categoryId])
  @@index([active])
  @@map("gallery_items")
}

// ── 3.9 Facility ─────────────────────────────────────────────────────────
// Fixed master list of exactly 10 facilities (see README "Facilities master list") — `slug` is
// the stable identifier the frontend uses to look up each facility's icon; it is assigned once
// by the seed/migration and never admin-editable (facility rows are no longer admin-creatable
// or admin-deletable, only their photos are).
model Facility {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  coverImageId String?  @map("cover_image_id")
  coverImage   Media?   @relation("FacilityCoverImage", fields: [coverImageId], references: [id])
  facilityType String?  @map("facility_type")
  location     String?
  status       String?
  order        Int      @default(0)
  active       Boolean  @default(true)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  /// i18n — non-English overrides for name/description/facilityType/location/status.
  translations Json?

  gallery FacilityGalleryImage[]

  @@map("facilities")
}

// Join table implementing the ERD relation "FACILITY ||--o{ MEDIA : memiliki galeri"
// (docs/04-database.md §2) — FR-FAC-02 requires a facility to have a photo gallery,
// not just a single cover image. Field-for-field mirror of FactoryGalleryImage below (see
// "About Company → Facilities" redesign) so the admin gallery editor and public lightbox can
// be shared/generalized between the two entities.
model FacilityGalleryImage {
  id         String   @id @default(cuid())
  facilityId String   @map("facility_id")
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  mediaId    String   @map("media_id")
  media      Media    @relation(fields: [mediaId], references: [id])
  title      String?
  caption    String?
  category   String?
  altText    String?  @map("alt_text")
  order      Int      @default(0)
  featured   Boolean  @default(false)
  active     Boolean  @default(true)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("facility_gallery")
}

// Section copy + auto-rotation settings for the redesigned "Our Facilities" showcase — same
// singleton idiom as AboutCompanyTeamSection/HomepageProcessSection.
model AboutCompanyFacilitiesSection {
  id                    String   @id @default(cuid())
  eyebrow               String   @default("Built for Scale")
  heading               String   @default("Our Facilities")
  description           String   @default("")
  autoRotate            Boolean  @default(true) @map("auto_rotate")
  rotateIntervalSeconds Int      @default(6) @map("rotate_interval_seconds")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for eyebrow/heading/description.
  translations          Json?

  @@map("about_company_facilities_section")
}

// "Facilities → MOQ & Payment Terms" — ordering/payment intro + Supply Capacity panel +
// Commitment statement + closing CTA copy (singleton, same get-or-create idiom as
// AboutCompanyFacilitiesSection).
model AboutCompanyMoqPaymentSection {
  id                         String   @id @default(cuid())
  eyebrow                    String   @default("ORDERING & PAYMENT TERMS")
  heading                    String   @default("Minimum Order & Payment Terms")
  introduction               String   @default("PPN supports regular and large-volume coconut product procurement for both local and international buyers. We provide clear and flexible transaction processes based on product type, order volume, specifications, and mutual agreement.")
  supplyCapacityTitle        String   @default("Supply Capacity") @map("supply_capacity_title")
