  estimatedQuantity String?                @map("estimated_quantity")
  message           String
  status            QuotationRequestStatus @default(new)
  sourcePage        String                 @map("source_page")
  createdAt         DateTime               @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@index([productId])
  @@map("quotation_requests")
}

// ── 3.15 SiteSetting ─────────────────────────────────────────────────────
model SiteSetting {
  id           String @id @default(cuid())
  key          String @unique
  value        String
  group        String
  /// i18n — non-English overrides for value, e.g. {"id": {"value": "..."}, "zh": {...}}.
  translations Json?

  @@map("site_settings")
}

// ── 3.16 SiteBranding (Post-Launch, singleton) ────────────────────────────
// Header/Footer/Mobile logo + Favicon — deliberately its own small table rather than
// SiteSetting rows, since SiteSetting.value is a flat string with no room for a Media
// relation/alt-text/enabled-flag bundle per slot. Follows the same get-or-create singleton
// pattern as HomepageAboutPreview/HomepagePartnersSection/HomepageShippingSection.
model SiteBranding {
  id String @id @default(cuid())

  headerLogoId      String? @map("header_logo_id")
  headerLogo        Media?  @relation("SiteBrandingHeaderLogo", fields: [headerLogoId], references: [id])
  headerLogoEnabled Boolean @default(true) @map("header_logo_enabled")
  headerLogoAlt     String? @map("header_logo_alt")

  footerLogoId      String? @map("footer_logo_id")
  footerLogo        Media?  @relation("SiteBrandingFooterLogo", fields: [footerLogoId], references: [id])
  footerLogoEnabled Boolean @default(true) @map("footer_logo_enabled")
  footerLogoAlt     String? @map("footer_logo_alt")

  mobileLogoId  String? @map("mobile_logo_id")
  mobileLogo    Media?  @relation("SiteBrandingMobileLogo", fields: [mobileLogoId], references: [id])
  useMobileLogo Boolean @default(false) @map("use_mobile_logo")
  mobileLogoAlt String? @map("mobile_logo_alt")

  faviconId String? @map("favicon_id")
  favicon   Media?  @relation("SiteBrandingFavicon", fields: [faviconId], references: [id])

  /// Custom background photo for the breadcrumb/title bar on the Product Detail page
  /// template only (PageHeader.tsx) — shared across all products, not per-product.
  productHeaderBackgroundId String? @map("product_header_background_id")
  productHeaderBackground   Media?  @relation("SiteBrandingProductHeaderBackground", fields: [productHeaderBackgroundId], references: [id])

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("site_branding")
}

// ── 3.17 About Company CMS (Post-Launch) ──────────────────────────────────
// Draft/Publish architecture mirrors the Homepage Manager exactly (see
// HomepageSectionConfig/HomepagePublishedSnapshot above): every table below is the "draft"
// working copy Admin edits directly; AboutCompanyPublishedSnapshot is an append-only frozen
// copy created on Publish, and the public /about page reads only the latest snapshot.

model AboutCompanySectionConfig {
  id        String   @id @default(cuid())
  key       String   @unique // "company" | "team" | "what_we_do" | "legal_certificate" | "factory"
  order     Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("about_company_section_config")
}

model AboutCompanyPublishedSnapshot {
  id          String   @id @default(cuid())
  data        Json
  publishedAt DateTime @default(now()) @map("published_at")

  @@index([publishedAt])
  @@map("about_company_published_snapshot")
}

// Section 01 "CV. Putri Palma Nusantara" (singleton, get-or-create — same idiom as
// HomepageAboutPreview).
model AboutCompanyProfile {
  id               String   @id @default(cuid())
  headline         String   @default("CV. Putri Palma Nusantara")
  shortDescription String   @default("") @map("short_description")
  mainDescription  String   @default("") @map("main_description")
  vision           String   @default("")
  mission          String   @default("")
  companyOverview  String   @default("") @map("company_overview")
  mainImageId      String?  @map("main_image_id")
  mainImage        Media?   @relation("AboutCompanyMainImage", fields: [mainImageId], references: [id])
  /// Any supported YouTube URL format (watch/youtu.be/embed) — the video ID is extracted on
  /// the frontend, so the Admin never has to construct an embed URL by hand.
  youtubeVideoUrl  String?  @map("youtube_video_url")
  /// "Connect With PPN" social row, shown directly under the video.
  socialLabel      String   @default("Connect With PPN") @map("social_label")
  socialVisible    Boolean  @default(true) @map("social_visible")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for every translatable text field on this singleton.
  translations     Json?

  // ── Storytelling blocks (Post-Launch company-profile redesign) ────────────
  // All blocks live on this one singleton rather than in separate tables: they are all the
  // same entity ("the company profile"), always read and published together, and a single
  // row keeps the Admin PUT atomic. Every block carries its own `*Visible` flag so an Admin
  // can turn a block off instead of being forced to invent content for it — nothing is
  // pre-filled with fabricated company claims.

  /// 01 Introduction.
  eyebrow    String  @default("Who We Are")
  subheading String  @default("")
  ctaLabel   String? @map("cta_label")
  ctaHref    String? @map("cta_href")

  /// 02 Company Story.
  storyLabel                String  @default("About PPN") @map("story_label")
  storyHeading              String  @default("") @map("story_heading")
  storyDescription          String  @default("") @map("story_description")
  storySecondaryDescription String  @default("") @map("story_secondary_description")
  storyImageId              String? @map("story_image_id")
  storyImage                Media?  @relation("AboutCompanyStoryImage", fields: [storyImageId], references: [id])
  storyVisible              Boolean @default(true) @map("story_visible")

  /// 03 Business Scope — renders the existing WhatWeDoItem records inside the profile story.
  /// Defaults to hidden so enabling it is a deliberate choice: "What We Do?" is also its own
  /// section on the About page, and showing both would repeat the same content twice.
  scopeLabel       String  @default("What We Do") @map("scope_label")
  scopeHeading     String  @default("") @map("scope_heading")
  scopeDescription String  @default("") @map("scope_description")
  scopeVisible     Boolean @default(false) @map("scope_visible")

  /// 05 Company Facts (rows live in AboutCompanyFact).
  factsLabel   String  @default("Company Facts") @map("facts_label")
  factsHeading String  @default("") @map("facts_heading")
  factsVisible Boolean @default(true) @map("facts_visible")

  /// 06/07 Global Export Reach — reuses the existing ExportDestination records and world map
  /// component; only this section's own copy lives here.
  exportLabel       String  @default("Global Export Reach") @map("export_label")
  exportHeading     String  @default("") @map("export_heading")
  exportDescription String  @default("") @map("export_description")
  exportVisible     Boolean @default(true) @map("export_visible")

  /// 08 Legal / company information. Blank fields are never rendered publicly.
  legalLabel        String  @default("Company Information") @map("legal_label")
  legalHeading      String  @default("") @map("legal_heading")
  businessType      String  @default("") @map("business_type")
  registeredAddress String  @default("") @map("registered_address")
  businessIdNumber  String  @default("") @map("business_id_number")
  establishedYear   String  @default("") @map("established_year")
  legalVisible      Boolean @default(true) @map("legal_visible")

  /// 09 Closing statement.
  closingLabel       String  @default("") @map("closing_label")
  closingHeading     String  @default("") @map("closing_heading")
  closingDescription String  @default("") @map("closing_description")
  closingCtaLabel    String? @map("closing_cta_label")
  closingCtaHref     String? @map("closing_cta_href")
  closingVisible     Boolean @default(true) @map("closing_visible")

  gallery AboutCompanyGalleryImage[]

  @@map("about_company_profile")
}

/// One "Company Facts" row (item 17/18/40) — label/value pairs the Admin fully controls, so
/// the public grid only ever shows facts that actually exist. Deliberately generic rather
/// than fixed columns: the brief's own fact list is a suggestion, not a schema.
model AboutCompanyFact {
  id           String   @id @default(cuid())
  label        String
  value        String
  /// Optional icon key resolved by the public component's own allowlist — never a raw URL.
  icon         String?
  order        Int      @default(0)
  active       Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for label/value.
  translations Json?

  @@map("about_company_facts")
}

model AboutCompanyGalleryImage {
  id        String              @id @default(cuid())
  profileId String              @map("profile_id")
  profile   AboutCompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaId   String              @map("media_id")
  media     Media               @relation("AboutCompanyGalleryMedia", fields: [mediaId], references: [id])
  caption   String?
  altText   String?             @map("alt_text")
  order     Int                 @default(0)
  featured  Boolean             @default(false)
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at")

  @@map("about_company_gallery")
}

/// "Connect With PPN" social row under the company-profile video — free-choice platform per
/// row (unlike Contact Page's fixed four-slot social fields), since this section explicitly
/// asks for an open CRUD list including optional platforms (YouTube/WhatsApp/X/Other).
model AboutCompanySocialLink {
  id           String   @id @default(cuid())
  /// Free-text key used to pick an icon on the frontend (e.g. "instagram", "tiktok",
  /// "facebook", "linkedin", "youtube", "whatsapp", "twitter", "other") — not an enum, so a
  /// platform the Admin needs later doesn't require a schema change.
  platform     String
  displayName  String   @map("display_name")
  url          String
  active       Boolean  @default(true)
  openInNewTab Boolean  @default(true) @map("open_in_new_tab")
  order        Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("about_company_social_links")
}

// Section 02 "PPN Team".
model TeamMember {
  id               String   @id @default(cuid())
  name             String
  position         String
  biography        String   @default("")
  /// Free text or a newline-separated list; the public profile modal renders newline-separated
  /// lines as bullets. Kept as plain text because the Admin form here is a plain textarea.
  responsibilities String   @default("")
  /// Optional grouping ("Management", "Operations", …) so the same model can later drive
  /// several team lists without a schema change. Free text, not an enum: departments differ
  /// per company and an enum would need a migration for every new one.
  department       String?
  photoId          String?  @map("photo_id")
  photo            Media?   @relation("TeamMemberPhoto", fields: [photoId], references: [id])
  /// Renamed from `social_link` — it always held a profile URL, and the public card now
  /// labels it as LinkedIn. Renamed in place so existing values survive.
  linkedinUrl      String?  @map("linkedin_url")
  email            String?
  phone            String?
  order            Int      @default(0)
  active           Boolean  @default(true)
  featured         Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for name/position/biography/responsibilities/department.
  translations     Json?

  @@map("team_members")
}

/// Section 02's own heading copy (singleton, get-or-create). Separate from TeamMember so the
/// section keeps its title/description even when no members exist yet, and separate from
/// AboutCompanyProfile because it belongs to a different section of the page.
model AboutCompanyTeamSection {
  id           String   @id @default(cuid())
  eyebrow      String   @default("Meet the Team")
  heading      String   @default("The People Behind PPN")
  description  String   @default("")
  ctaLabel     String?  @map("cta_label")
  ctaHref      String?  @map("cta_href")
  /// Shows a live count of published team members. Off by default — a counter is only honest
  /// when it is derived, and only useful once there are enough members to be worth stating.
  showCounter  Boolean  @default(false) @map("show_counter")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for eyebrow/heading/description/ctaLabel.
  translations Json?

  @@map("about_company_team_section")
}

// Section 03 "What We Do?" — mediaId is a single field the Admin uses for either a photo or
// an icon (SVG/PNG/WebP all pass the existing Media upload's `image/` MIME allowlist); the
// brief explicitly asks for "image OR icon", not both, so one optional relation is enough.
model WhatWeDoItem {
  id                  String   @id @default(cuid())
  title               String
  shortDescription    String   @default("") @map("short_description")
  detailedDescription String   @default("") @map("detailed_description")
  /// Short bullet points shown under the card description (e.g. "Export-oriented fresh
  /// coconut", "Flexible sourcing") — a plain string list, not rich text.
  keyPoints           String[] @default([]) @map("key_points")
  mediaId             String?  @map("media_id")
  media               Media?   @relation("WhatWeDoMedia", fields: [mediaId], references: [id])
  /// Optional link to a real catalogue product. A relation rather than a stored URL so the
  /// public link is always built from the product's current slug and can never go stale or
  /// point at a product that no longer exists.
  productId           String?  @map("product_id")
  product             Product? @relation("WhatWeDoProduct", fields: [productId], references: [id], onDelete: SetNull)
  order               Int      @default(0)
  active              Boolean  @default(true)
  featured            Boolean  @default(false)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title/shortDescription/detailedDescription.
  translations        Json?

  @@map("what_we_do_items")
}

/// Section-level copy for "What We Supply" (public heading is Admin-editable; the section key
/// in `AboutCompanySectionConfig` stays "what_we_do" — renaming it would be a breaking change to
/// the fixed 5-key section-navigator system, so only the public-facing text changes). Also
/// carries the "Who We Supply" sub-block's copy and the Buyer/Supplier CTA copy, since both live
/// inside this same section's component rather than becoming new top-level sections.
model AboutCompanyWhatWeDoSection {
  id                     String   @id @default(cuid())
  eyebrow                String   @default("What We Supply")
  heading                String   @default("Coconut Products for Global Markets")
  description            String   @default("From fresh coconuts to processed coconut-derived products, PPN supports international buyers with flexible sourcing, quality-focused handling, and export-oriented supply.")
  whoHeading             String   @default("Serving Buyers Across the Coconut Value Chain") @map("who_heading")
  whoDescription          String   @default("PPN works with businesses across the coconut supply chain, from international importers and manufacturers to distributors and industrial users.") @map("who_description")
  buyerCtaHeading        String   @default("Looking for Coconut Products?") @map("buyer_cta_heading")
  buyerCtaDescription    String   @default("Talk to the PPN team about product specifications, availability, packaging, volume requirements, and export destinations.") @map("buyer_cta_description")
  buyerCtaButtonText     String   @default("Explore Our Products") @map("buyer_cta_button_text")
  supplierCtaHeading     String   @default("Want to Supply PPN?") @map("supplier_cta_heading")
  supplierCtaDescription String   @default("We work with farmers, collectors, suppliers and long-term sourcing partners across Indonesia.") @map("supplier_cta_description")
  supplierCtaButtonText  String   @default("Our Supply Network") @map("supplier_cta_button_text")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for the text fields above.
  translations           Json?

  @@map("about_company_what_we_do_section")
}

/// "Who We Supply" audience segments (Importers/Manufacturers/Distributors/Industrial Users/
/// Long-term Partners) — a flat repeatable list, not tied to any product or external record.
model WhoWeSupplyItem {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  /// Fixed icon-key allowlist (see `WHO_WE_SUPPLY_ICONS` in shared-types) — never raw markup or
  /// a remote asset URL.
  icon         String?
  order        Int      @default(0)
  active       Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title/description.
  translations Json?

  @@map("who_we_supply_items")
}

// Section 04 "Legal & Certificate" — fileId accepts a PDF or an image Media row (the existing
// Media model already distinguishes file_type; the Admin UI picks the right upload/preview
// treatment based on it). previewImageId is an optional separate thumbnail for a PDF document
// (a PDF has no native image preview), left unset for image-type documents.
enum LegalDocumentType {
  certificate
  legal_document
  business_license
  registration_document
  export_certificate
  quality_certificate
  other
}

/// Admin-managed document categories, replacing the fixed `LegalDocumentType` enum: the brief
/// requires add/edit/delete/reorder/activate, none of which an enum can do without a migration
/// per change. `documentType` is kept on the document as a read-only legacy column so existing
/// rows and published snapshots keep resolving while categories become the source of truth.
model LegalDocumentCategory {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  order        Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for name/description.
  translations Json?

  documents LegalCertificateDocument[]

  @@map("legal_document_categories")
}

model LegalCertificateDocument {
  id                  String                 @id @default(cuid())
  title               String
  documentType        LegalDocumentType      @default(other) @map("document_type")
  categoryId          String?                @map("category_id")
  category            LegalDocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Optional issuing country, shown next to the institution when set.
  country             String?
