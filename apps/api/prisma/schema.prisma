  export_ready
  consistency
  sustainability
  service
  pricing
  delivery
}

model HomepageWhyChooseUs {
  id           String                  @id @default(cuid())
  icon         HomepageWhyChooseUsIcon @default(quality)
  title        String
  order        Int                     @default(0)
  enabled      Boolean                 @default(true)
  featured     Boolean                 @default(true)
  updatedAt    DateTime                @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title.
  translations Json?

  @@map("homepage_why_choose_us")
}

// ── 3.11h ExportDestination (Post-Launch) ─────────────────────────────────
// "Global Export Reach" world map — zero rows is a valid state (map renders with no
// country highlighted; see apps/web ExportReachSection.tsx). Only "active_destination" +
// enabled rows are ever exposed publicly; the other three ExportStatus values are Admin-side
// bookkeeping so a lapsed/prospective market's data isn't lost when it stops being current.
enum ExportStatus {
  active_destination
  previous_destination
  potential_market
  inactive
}

model ExportDestination {
  id                   String       @id @default(cuid())
  /// ISO 3166-1 alpha-2, e.g. "TH" — matches the `data-alpha2` attribute on the world map SVG.
  countryCode          String       @unique @map("country_code")
  countryCodeAlpha3    String       @map("country_code_alpha3")
  countryName          String       @map("country_name")
  exportStatus         ExportStatus @default(active_destination) @map("export_status")
  /// Optional grouping label shown next to the country (e.g. "Southeast Asia"). Free text,
  /// not an enum — regional naming differs by audience and this is display copy.
  region               String?
  description          String?
  exportVolume         String?      @map("export_volume")
  exportFrequency      String?      @map("export_frequency")
  destinationPort      String?      @map("destination_port")
  products             Product[]    @relation("ExportDestinationProducts")
  order                Int          @default(0)
  enabled              Boolean      @default(true)
  featured             Boolean      @default(false)
  /// Independent curation flag for the About Company → "CV. Putri Palma Nusantara" →
  /// "Countries We Have Exported To" flag grid — deliberately separate from `featured` (which
  /// gates the Homepage's own Global Export Reach map), so activating a country on one surface
  /// never silently activates it on the other. Same underlying country record either way; only
  /// the visibility per surface differs.
  showInCompanyProfile Boolean      @default(false) @map("show_in_company_profile")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  /// i18n — non-English overrides for countryName/description.
  translations         Json?

  @@index([enabled, exportStatus])
  @@map("export_destinations")
}

// Singleton — "Global Export Reach" section heading/subtitle, editable independently of the
// individual destination records (same get-or-create pattern as HomepagePartnersSection).
model HomepageExportReach {
  id           String   @id @default(cuid())
  heading      String   @default("Global Export Reach")
  subtitle     String   @default("Connecting Indonesian coconut products with buyers across international markets.")
  enabled      Boolean  @default(true)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for heading/subtitle.
  translations Json?

  @@map("homepage_export_reach")
}

// ── 3.11i ShippingPartner (Post-Launch) ───────────────────────────────────
// "Global Shipping Partner" carousel. Not every shipping company shown is necessarily a
// confirmed formal business partner (brief §"Data Terminology") — relationshipType lets
// Admin record the true relationship per record while the public section keeps its generic
// "Global Shipping Partner" title. Same enabled+featured dual-gate as PartnerLogo.
enum ShippingRelationshipType {
  shipping_partner
  shipping_line
  carrier
  logistics_partner
  freight_network
  service_provider
  other
}

model ShippingPartner {
  id               String                   @id @default(cuid())
  logoId           String                   @map("logo_id")
  logo             Media                    @relation(fields: [logoId], references: [id])
  partnerName      String                   @map("partner_name")
  relationshipType ShippingRelationshipType @default(shipping_partner) @map("relationship_type")
  description      String?
  websiteUrl       String?                  @map("website_url")
  openInNewTab     Boolean                  @default(true) @map("open_in_new_tab")
  altText          String?                  @map("alt_text")
  order            Int                      @default(0)
  enabled          Boolean                  @default(true)
  featured         Boolean                  @default(true)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  /// i18n — non-English overrides for partnerName/description.
  translations     Json?

  @@map("shipping_partners")
}

// Singleton — "Global Shipping Partner" section heading/subtitle/marquee + display toggles,
// editable independently of the individual partner records (same get-or-create pattern as
// HomepagePartnersSection/HomepageExportReach).
model HomepageShippingSection {
  id                     String   @id @default(cuid())
  title                  String   @default("GLOBAL SHIPPING PARTNER")
  subtitle               String   @default("Connecting our export operations with reliable shipping and logistics networks for international delivery.")
  marqueeDurationSeconds Int      @default(50) @map("marquee_duration_seconds")
  showPartnerName        Boolean  @default(true) @map("show_partner_name")
  showRelationshipType   Boolean  @default(true) @map("show_relationship_type")
  enabled                Boolean  @default(true)
  updatedAt              DateTime @updatedAt @map("updated_at")
  /// i18n — non-English overrides for title/subtitle.
  translations           Json?

  @@map("homepage_shipping_section")
}

// ── 3.11j Homepage Manager: Draft/Publish (Post-Launch) ──────────────────
// Every Homepage table above stays exactly as it is — it's the Admin's "draft" working copy,
// unchanged. These two models add a Draft/Published separation on top, without it: `visible`/
// `order` here are additional gates layered OVER each section's own existing logic (never
// replacing an existing `enabled` field), and HomepagePublishedSnapshot is a frozen, versioned
// copy of the whole homepage that the PUBLIC site reads from — see README "Homepage Manager".
model HomepageSectionConfig {
  id        String   @id @default(cuid())
  /// Stable key, e.g. "hero_slider", "shipping_partner" — matches the frontend section registry.
  key       String   @unique
  order     Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("homepage_section_config")
}

// Append-only — old rows are never deleted or mutated, so "restore a previous version" is just
// "publish an old row's `data` again" (see `restoreSnapshot` in homepage.service.ts).
model HomepagePublishedSnapshot {
  id          String   @id @default(cuid())
  /// Raw (untranslated) rows per section, locale-resolved at read time via the same mappers
  /// every live endpoint already uses — one snapshot serves all 6 locales.
  data        Json
  publishedAt DateTime @default(now()) @map("published_at")

  @@index([publishedAt])
  @@map("homepage_published_snapshot")
}

// ── 3.12 FAQ ─────────────────────────────────────────────────────────────
model Faq {
  id           String        @id @default(cuid())
  question     String
  answer       String
  order        Int           @default(0)
  status       ContentStatus @default(draft)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  /// i18n — non-English overrides for question/answer.
  translations Json?

  @@map("faqs")
}

// ── 3.13 QuotationRequest ───────────────────────────────────────────────
enum QuotationRequestType {
  quotation
  general_contact
}

enum QuotationRequestStatus {
  new
  in_progress
  done
}

model QuotationRequest {
