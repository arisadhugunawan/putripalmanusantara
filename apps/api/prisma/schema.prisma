// ── 3.11j Homepage Manager: Draft/Publish (Post-Launch) ──────────────────
// Every Homepage table above stays exactly as it is — it's the Admin's "draft" working copy,
// unchanged. These two models add a Draft/Published separation on top, without it: `visible`/
// `order` here are additional gates layered OVER each section's own existing logic (never
// replacing an existing `enabled` field), and HomepagePublishedSnapshot is a frozen, versioned
// copy of the whole homepage that the PUBLIC site reads from — see README "Homepage Manager".
model HomepageSectionConfig {
  id        String   @id @default(cuid())
  /// Stable key, e.g. "hero_slider", "shipping_partner" — matches the frontend section registry.
  key       String   @unique
  order     Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("homepage_section_config")
}

// Append-only — old rows are never deleted or mutated, so "restore a previous version" is just
// "publish an old row's `data` again" (see `restoreSnapshot` in homepage.service.ts).
model HomepagePublishedSnapshot {
  id          String   @id @default(cuid())
  /// Raw (untranslated) rows per section, locale-resolved at read time via the same mappers
  /// every live endpoint already uses — one snapshot serves all 6 locales.
  data        Json
  publishedAt DateTime @default(now()) @map("published_at")

  @@index([publishedAt])
  @@map("homepage_published_snapshot")
}

